theorem fallback_body (s : MachineState)
    (h6 : s.getReg .x6 = BitVec.ofNat 64 0x20F0)
    (h7 : s.getReg .x7 = BitVec.ofNat 64 0x3F40) :
    readBuffer (fallback.res.toState (first.res.toState s)) 0x3F40 12 =
      word (q s) 3 ++ word (q s) 2 ++ word (q s) 1 := by
  let t := first.res.toState s
  have ht7 : t.getReg .x7 = BitVec.ofNat 64 0x3F40 := by
    simpa only [t, Radix12SignState.v0, Radix12Rank0.v0] using
      (Radix12SignState.v0_x7 s).trans h7
  rw [Radix12ReadBuffer12Try.readBuffer12,
    Radix12FallbackMemTry.fallback_highmem t ht7,
    Radix12FallbackMemTry.fallback_lowmem t ht7]
  simp only [t, Radix12SignLoaded.first_x10 s h6,
    Radix12SignLoaded.first_x11 s h6,
    Radix12SignLoaded.first_x12 s h6]
  simp only [BitVec.truncate_eq_setWidth, Radix12SignTailPaths.q]
  repeat rw [BitVec.setWidth_setWidth_of_le (h := by decide)]
  simp only [BitVec.setWidth_eq]
  rw [BitVec.append_assoc']
