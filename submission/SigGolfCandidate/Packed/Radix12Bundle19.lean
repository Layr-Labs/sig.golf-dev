theorem body_buffer {s t : MachineState}
    (hf : Frame s t (fun a => 0x3F40 ≤ a)) :
    readBuffer t 0x2650 6384 = readBuffer s 0x2650 6384 := by
  apply readBuffer_eq_of_bytes
  intro j hj
