set_option maxHeartbeats 1000000
namespace Radix12Pack96Try
open RiscvZkvm.Rv64

theorem pack96_words (r : Word) (l : BitVec 60)
    (hr : r.toNat < 2^36) :
    ((r >>> 4).truncate 32) ++ ((r <<< 60) ||| l.zeroExtend 64) =
      BitVec.ofNat 96 (r.toNat * 2^60 + l.toNat) := by
  have hl := BitVec.isLt l
  have hshift : (r <<< 60).toNat = (r.toNat % 16) * 2^60 := by
    rw [BitVec.toNat_shiftLeft, Nat.shiftLeft_eq]
    omega
  have hlow : ((r <<< 60) ||| l.zeroExtend 64).toNat =
      (r.toNat % 16) * 2^60 + l.toNat := by
    rw [BitVec.toNat_or, hshift,
      BitVec.zeroExtend_eq_setWidth,
      BitVec.toNat_setWidth_of_le (by decide)]
    simpa only [Nat.shiftLeft_eq] using
      (Nat.shiftLeft_add_eq_or_of_lt hl (r.toNat % 16)).symm
  have hhigh : ((r >>> 4).truncate 32).toNat = r.toNat / 16 := by
    simp only [BitVec.truncate_eq_setWidth, BitVec.toNat_setWidth,
      BitVec.toNat_ushiftRight, Nat.shiftRight_eq_div_pow]
    omega
  apply BitVec.eq_of_toNat_eq
  rw [BitVec.toNat_append, ← Nat.shiftLeft_add_eq_or_of_lt
    (BitVec.isLt ((r <<< 60) ||| l.zeroExtend 64)),
    Nat.shiftLeft_eq, hhigh, hlow, BitVec.toNat_ofNat]
  omega

#print axioms pack96_words
end Radix12Pack96Try
end
