theorem fallback_pack (q : BitVec 160)
    (hbad : ¬ Radix12.counterSum
      (highWords (Radix12.countersQ q)) < 381) :
    packSplit q = word q 3 ++ word q 2 ++ word q 1 := by
  apply BitVec.eq_of_toNat_eq
  unfold packSplit
  rw [BitVec.toNat_ofNat]
  rw [Radix12Split.encode, if_neg hbad]
  simp only [Radix12.badPayload, Radix12.countersQ]
  rw [BitVec.toNat_append, BitVec.toNat_append]
  rw [← Nat.shiftLeft_add_eq_or_of_lt (by
    have := BitVec.isLt (word q 2)
    omega)]
  rw [← Nat.shiftLeft_add_eq_or_of_lt (by
    have := BitVec.isLt (word q 1)
    omega)]
  simp only [Nat.shiftLeft_eq]
  have h1 := BitVec.isLt (word q 1)
  have h2 := BitVec.isLt (word q 2)
  have h3 := BitVec.isLt (word q 3)
  norm_num at *
  omega

#print axioms fallback_pack
end Radix12FallbackCodecTry
