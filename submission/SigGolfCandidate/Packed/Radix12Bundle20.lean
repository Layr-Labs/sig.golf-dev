    (toList (n := 12) (trailer b)).getD i 0 =
      (toList b).getD (6384 + i) 0 := by
  rw [toList_split12]
  simp only [List.getD_eq_getElem?_getD]
  rw [List.getElem?_append_right (by rw [length_toList]; omega)]
