-- BEGIN Radix12FlatSlice from /tmp/Radix12FlatSlice.lean
section

namespace Radix12FlatSlice

theorem flatMap_block_slice {α β : Type} (xs : List α) (f : α → List β)
    (m : Nat) (hlen : ∀ a ∈ xs, (f a).length = m) :
    ∀ (i : Nat) (hi : i < xs.length),
      ((xs.flatMap f).drop (m * i)).take m = f xs[i] := by
  induction xs with
  | nil => intro i hi; simp at hi
  | cons a xs ih =>
      intro i hi
      have ha : (f a).length = m := hlen a (by simp)
      have htail : ∀ b ∈ xs, (f b).length = m := by
        intro b hb
        exact hlen b (by simp [hb])
      cases i with
      | zero =>
          simp only [Nat.mul_zero, List.drop_zero, List.flatMap_cons,
            List.getElem_cons_zero]
          rw [List.take_append_of_le_length (by omega), List.take_of_length_le (by omega)]
      | succ j =>
          have hj : j < xs.length := by simpa using hi
          simp only [List.flatMap_cons, List.getElem_cons_succ]
          rw [show m * (j+1) = (f a).length + m * j by
                rw [Nat.mul_succ, ha]; omega,
            List.drop_length_add_append]
          exact ih htail j hj

#print axioms flatMap_block_slice
end Radix12FlatSlice
end
