namespace Radix12SplitTableEq
open SigGolfCandidate.Ref Radix12SplitExpandImage
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000

def expected : List (BitVec 8) :=
  (List.range 5).flatMap fun k =>
    (List.range 385).flatMap fun n => leBytes 8 (Nat.choose n (k + 1))

theorem table_eq : tableData = expected := by
  decide +kernel

def expectedFlat : List (BitVec 8) :=
  (List.range (5 * 385)).flatMap fun i =>
    leBytes 8 (Nat.choose (i % 385) (i / 385 + 1))

theorem expected_eq_flat : expected = expectedFlat := by
  decide +kernel

theorem table_eq_flat : tableData = expectedFlat := table_eq.trans expected_eq_flat

#print axioms table_eq
#print axioms table_eq_flat
end Radix12SplitTableEq
