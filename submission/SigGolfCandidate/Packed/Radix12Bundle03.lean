section

namespace Radix12SplitTableRead
open RiscvZkvm.Rv64 SigGolfCandidate.Ref SigGolfCandidate.Budget
  Radix12SplitExpandImage Radix12SplitTableEq Radix12FlatSlice

theorem table_slice (i : Nat) (hi : i < 5 * 385) :
    (tableData.drop (8 * i)).take 8 =
      leBytes 8 (Nat.choose (i % 385) (i / 385 + 1)) := by
  rw [table_eq_flat]
  change (((List.range (5 * 385)).flatMap
    (fun j => leBytes 8 (Nat.choose (j % 385) (j / 385 + 1)))).drop (8 * i)).take 8 = _
  have h := flatMap_block_slice (List.range (5 * 385))
    (fun j => leBytes 8 (Nat.choose (j % 385) (j / 385 + 1))) 8
    (by intro a ha; simp [leBytes]) i (by simpa using hi)
  simpa using h

theorem table_word (i : Nat) (hi : i < 5 * 385) :
    bytesToWordLE ((tableData.drop (8 * i)).take 8) =
      BitVec.ofNat 64 (Nat.choose (i % 385) (i / 385 + 1)) := by
  rw [table_slice i hi, SigGolfCandidate.Keygen.bytesToWordLE_eq,
    SigGolfCandidate.Budget.leNat_leBytes]
  norm_num
  apply BitVec.eq_of_toNat_eq
  simp only [BitVec.toNat_ofNat, Nat.mod_mod]

#print axioms table_slice
#print axioms table_word
end Radix12SplitTableRead
