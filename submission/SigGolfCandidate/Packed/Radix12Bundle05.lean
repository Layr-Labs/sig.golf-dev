      (((s.getReg .x11 - 1#64) * s.getReg .x27 + s.getReg .x14) <<< 3) +
          s.getReg .x2 =
        BitVec.ofNat 64 (0xffc3d0 + 8 * ((k - 1) * 385 + bar)) := by
    rw [h11, h27, h14, h2]
    exact Radix12SplitTableAddr.table_addr_arith k bar hk hk5 hbar
  have hscratch :
      ((s.getReg .x11 - 1#64) <<< 3) + s.getReg .x28 =
        BitVec.ofNat 64 (0x4000 + 8 * (k - 1)) := by
    rw [h11, h28, BitVec.ofNat_sub_ofNat_of_le k 1 (by decide) hk,
      BitVec.shiftLeft_eq_mul_twoPow]
    have hpow : BitVec.twoPow 64 3 = BitVec.ofNat 64 8 := by decide
    rw [hpow]
    simp only [← BitVec.ofNat_mul, ← BitVec.ofNat_add]
    congr 1
    omega
  simp only [Result.obligs, post.res, rv_simp]
  simp only [show ((3#64).toNat % 64) = 3 by decide]
  rw [htable, hscratch]
  have haddrT : 0xffc3d0 + 8 * ((k - 1) * 385 + bar) < 2 ^ 64 := by omega
  have haddrS : 0x4000 + 8 * (k - 1) < 2 ^ 64 := by omega
  constructor
  · intro heq
    have hn := congrArg BitVec.toNat heq
    simp only [BitVec.toNat_ofNat, Nat.mod_eq_of_lt haddrT,
      Nat.mod_eq_of_lt haddrS] at hn
    omega
  constructor
  · apply (accessValid_iff _ _).2
    rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt haddrT]
    simp only [MEMORY_BYTES]
    constructor <;> omega
  · apply (accessValid_iff _ _).2
    rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt haddrS]
    simp only [MEMORY_BYTES]
    constructor <;> omega

theorem post_steps_bounded (s : MachineState) (k bar : Nat)
    (hpc : s.pc = BitVec.ofNat 64 4324)
    (h11 : s.getReg .x11 = BitVec.ofNat 64 k)
    (h14 : s.getReg .x14 = BitVec.ofNat 64 bar)
    (h28 : s.getReg .x28 = BitVec.ofNat 64 0x4000)
    (h27 : s.getReg .x27 = BitVec.ofNat 64 385)
