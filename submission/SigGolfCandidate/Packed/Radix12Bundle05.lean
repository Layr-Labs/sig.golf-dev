section

namespace Radix12MachineBisect
open Radix12

/-- The RV64 loop executes all nine comparisons even after the bracket has width one. -/
def fixedBisect (k code lo hi : Nat) : Nat → Nat
  | 0 => lo
  | fuel + 1 =>
      let mid := (lo + hi) / 2
      if mid.choose k ≤ code then fixedBisect k code mid hi fuel
      else fixedBisect k code lo mid fuel

theorem fixedBisect_unit (k code lo fuel : Nat)
    (hlo : lo.choose k ≤ code) :
    fixedBisect k code lo (lo + 1) fuel = lo := by
  induction fuel with
  | zero => rfl
  | succ fuel ih =>
      have hmid : (lo + (lo + 1)) / 2 = lo := by omega
      simp only [fixedBisect, hmid, if_pos hlo, ih]

theorem fixedBisect_eq (k code fuel : Nat) :
    ∀ lo hi : Nat, lo.choose k ≤ code → lo < hi →
      fixedBisect k code lo hi fuel = bisectChoose k code lo hi fuel := by
  induction fuel with
  | zero => intro lo hi hlo hlt; rfl
  | succ fuel ih =>
      intro lo hi hlo hlt
      by_cases hwide : lo + 1 < hi
      · let mid := (lo + hi) / 2
        have hloMid : lo < mid := by dsimp [mid]; omega
        have hmidHi : mid < hi := by dsimp [mid]; omega
        by_cases hcomp : mid.choose k ≤ code
        · simpa [fixedBisect, bisectChoose, hwide, mid, hcomp] using
            ih mid hi hcomp hmidHi
        · simpa [fixedBisect, bisectChoose, hwide, mid, hcomp] using
            ih lo mid hlo hloMid
      · have hunit : hi = lo + 1 := by omega
        subst hi
        rw [fixedBisect_unit k code lo (fuel + 1) hlo]
        simp [bisectChoose]

theorem fixed9_spec (k code lo hi : Nat)
    (hlo : lo.choose k ≤ code) (hhi : code < hi.choose k)
    (hlt : lo < hi) (hgap : hi - lo ≤ 2 ^ 9) :
    let n := fixedBisect k code lo hi 9
    n.choose k ≤ code ∧ code < (n + 1).choose k ∧ lo ≤ n ∧ n < hi := by
  rw [fixedBisect_eq k code 9 lo hi hlo hlt]
  exact bisectChoose_spec k code 9 lo hi hlo hhi hlt hgap

#print axioms fixedBisect_eq
#print axioms fixed9_spec
end Radix12MachineBisect
end
-- END Radix12MachineBisect

-- BEGIN Radix12FixedPair from /tmp/Radix12FixedPair.lean
section

namespace Radix12FixedPair
open Radix12MachineBisect

def fixedPair (k code lo hi : Nat) : Nat → Nat × Nat
  | 0 => (lo, hi)
  | fuel + 1 =>
      let mid := (lo + hi) / 2
      if code < mid.choose k then fixedPair k code lo mid fuel
      else fixedPair k code mid hi fuel

theorem fixedPair_step (k code lo hi fuel : Nat) :
    fixedPair k code lo hi (fuel + 1) =
      fixedPair k code
        (if code < ((lo + hi) / 2).choose k then lo else (lo + hi) / 2)
        (if code < ((lo + hi) / 2).choose k then (lo + hi) / 2 else hi) fuel := by
  conv_lhs => rw [fixedPair]
  split_ifs <;> rfl

theorem round_bracket (k code lo hi : Nat)
    (hlohi : lo < hi) (hlo : lo.choose k ≤ code)
    (hhi : code < hi.choose k) :
    let mid := (lo + hi) / 2
    let lo' := if code < mid.choose k then lo else mid
    let hi' := if code < mid.choose k then mid else hi
    lo' < hi' ∧ lo'.choose k ≤ code ∧ code < hi'.choose k ∧ hi' ≤ hi := by
  let mid := (lo + hi) / 2
  have hmidlo : lo ≤ mid := by dsimp [mid]; omega
  have hmidhi : mid < hi := by dsimp [mid]; omega
  by_cases hc : code < mid.choose k
  · have hstrict : lo < mid := by
      by_contra h
      have heq : mid = lo := by omega
      rw [heq] at hc
      omega
    have hc' : code < ((lo + hi) / 2).choose k := by simpa only [mid] using hc
    simp only [hc', ↓reduceIte]
    exact ⟨hstrict, hlo, trivial, Nat.le_of_lt hmidhi⟩
  · have hc' : ¬code < ((lo + hi) / 2).choose k := by simpa only [mid] using hc
    simp only [hc', ↓reduceIte]
    exact ⟨hmidhi, Nat.le_of_not_lt hc, hhi, Nat.le_refl hi⟩

theorem fixedPair_fst (k code fuel : Nat) :
    ∀ lo hi : Nat, (fixedPair k code lo hi fuel).1 =
      fixedBisect k code lo hi fuel := by
  induction fuel with
  | zero => intro lo hi; rfl
  | succ fuel ih =>
      intro lo hi
      by_cases hc : code < ((lo + hi) / 2).choose k
      · have hc' : ¬((lo + hi) / 2).choose k ≤ code := by omega
        simp only [fixedPair, fixedBisect, hc, if_neg hc', ↓reduceIte]
        exact ih lo ((lo + hi) / 2)
      · simp only [fixedPair, fixedBisect, hc, ↓reduceIte]
        have hc' : ((lo + hi) / 2).choose k ≤ code := Nat.le_of_not_lt hc
        rw [if_pos hc']
        exact ih ((lo + hi) / 2) hi

#print axioms round_bracket
#print axioms fixedPair_step
#print axioms fixedPair_fst
end Radix12FixedPair
end
