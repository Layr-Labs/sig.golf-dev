section

namespace Radix12SplitSearchLoop
open RiscvZkvm.Rv64 SigGolfCandidate.Legacy SigGolfCandidate.Legacy.Riscv
  SigGolfCandidate.Rv Radix12SplitExpandImage
  Radix12SplitSearchRound Radix12FixedPair Radix12MachineBisect
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000

theorem search_loop : ∀ fuel : Nat, ∀ (s : MachineState) (k rank lo hi : Nat),
    s.pc = BitVec.ofNat 64 4268 →
    Core s k rank lo hi fuel →
    1 ≤ k → k ≤ 5 → lo < hi → hi ≤ 385 →
    lo.choose k ≤ rank → rank < hi.choose k →
    1 ≤ fuel → fuel ≤ 9 → rank < 2 ^ 64 →
    ∃ t n c, Steps expandImage s n c t ∧
      n ≤ 13 * fuel ∧ c ≤ 16 * fuel ∧
      Core t k rank (fixedPair k rank lo hi fuel).1
        (fixedPair k rank lo hi fuel).2 0 ∧
      t.pc = BitVec.ofNat 64 4324 := by
  intro fuel
  induction fuel with
  | zero =>
      intro s k rank lo hi hpc hs hk hk5 hlohi hhi hlo hrhi hfuel hfuel9 hrank
      omega
  | succ f ih =>
      intro s k rank lo hi hpc hs hk hk5 hlohi hhi hlo hrhi hfuel hfuel9 hrank
      let mid := (lo + hi) / 2
      let test := rank < Nat.choose mid k
      let lo' := if test then lo else mid
      let hi' := if test then mid else hi
      obtain ⟨t, n, c, hsteps, hn, hc, htcore, htpc⟩ :=
        search_round s k rank lo hi (f + 1) hpc hs hk hk5 hlohi hhi
          hfuel hfuel9 hrank
      have hb := Radix12FixedPair.round_bracket k rank lo hi hlohi hlo hrhi
      have hnew : lo' < hi' ∧ lo'.choose k ≤ rank ∧
          rank < hi'.choose k ∧ hi' ≤ hi := by
        simpa only [lo', hi', test, mid] using hb
      have hpair : fixedPair k rank lo hi (f + 1) =
          fixedPair k rank lo' hi' f := by
        simpa only [lo', hi', test, mid] using
          (Radix12FixedPair.fixedPair_step k rank lo hi f)
      have htcore' : Core t k rank lo' hi' f := by
        simpa only [lo', hi', test, mid, Nat.add_sub_cancel] using htcore
      by_cases hf0 : f = 0
      · subst f
        have hpc' : t.pc = BitVec.ofNat 64 4324 := by simpa using htpc
        have hp0 : fixedPair k rank lo hi 1 = (lo', hi') := by
          simpa only [fixedPair] using hpair
        refine ⟨t, n, c, hsteps, ?_, ?_, ?_, hpc'⟩
        · simpa using hn
        · simpa using hc
        · simpa only [hp0, Prod.fst, Prod.snd] using htcore'
      · have hfpos : 1 ≤ f := by omega
        have hpc' : t.pc = BitVec.ofNat 64 4268 := by
          simpa [show 1 < f + 1 by omega] using htpc
        obtain ⟨u, n', c', htail, hn', hc', hucore, hupc⟩ :=
          ih t k rank lo' hi' hpc' htcore' hk hk5 hnew.1
            (le_trans hnew.2.2.2 hhi) hnew.2.1 hnew.2.2.1
            hfpos (by omega) hrank
        refine ⟨u, n + n', c + c', hsteps.trans htail, ?_, ?_, ?_, hupc⟩
        · omega
        · omega
        · simpa only [hpair] using hucore

theorem search9_bar (s : MachineState) (k rank lo hi : Nat)
    (hpc : s.pc = BitVec.ofNat 64 4268)
    (hs : Core s k rank lo hi 9)
    (hk : 1 ≤ k) (hk5 : k ≤ 5)
    (hlohi : lo < hi) (hhi : hi ≤ 385)
    (hlo : lo.choose k ≤ rank) (hrhi : rank < hi.choose k)
    (hrank : rank < 2 ^ 64) :
    ∃ t n c, Steps expandImage s n c t ∧ n ≤ 117 ∧ c ≤ 144 ∧
      Core t k rank (fixedPair k rank lo hi 9).1
        (fixedPair k rank lo hi 9).2 0 ∧
      t.pc = BitVec.ofNat 64 4324 ∧
      t.getReg .x14 = BitVec.ofNat 64 (Radix12.bisectChoose k rank lo hi 9) := by
  obtain ⟨t, n, c, hsteps, hn, hc, hcore, hpc'⟩ :=
    search_loop 9 s k rank lo hi hpc hs hk hk5 hlohi hhi hlo hrhi
      (by decide) (by decide) hrank
  refine ⟨t, n, c, hsteps, ?_, ?_, hcore, hpc', ?_⟩
  · simpa using hn
  · simpa using hc
  · calc
      t.getReg .x14 = BitVec.ofNat 64 (fixedPair k rank lo hi 9).1 := hcore.x14
      _ = BitVec.ofNat 64 (fixedBisect k rank lo hi 9) := by
        rw [fixedPair_fst]
      _ = BitVec.ofNat 64 (Radix12.bisectChoose k rank lo hi 9) := by
        rw [fixedBisect_eq k rank 9 lo hi hlo hlohi]

#print axioms search_loop
#print axioms search9_bar
end Radix12SplitSearchLoop
end
