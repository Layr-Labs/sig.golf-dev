    (h28 : s.getReg .x28 = BitVec.ofNat 64 0x4000)
    (hk : 1 ≤ k) (hk5 : k ≤ 5) (hi : i < 5 * 385) :
    (post.res.toState s).getMem (BitVec.ofNat 64 (0xffc3d0 + 8 * i)) =
      s.getMem (BitVec.ofNat 64 (0xffc3d0 + 8 * i)) := by
  rw [post_mem, scratch_addr s k h11 h28 hk hk5]
  have hneq : BitVec.ofNat 64 (0xffc3d0 + 8 * i) ≠
      BitVec.ofNat 64 (0x4000 + 8 * (k - 1)) := by
    intro heq
    have hn := congrArg BitVec.toNat heq
    have ht : 0xffc3d0 + 8 * i < 2 ^ 64 := by omega
    have hs : 0x4000 + 8 * (k - 1) < 2 ^ 64 := by omega
    simp only [BitVec.toNat_ofNat, Nat.mod_eq_of_lt ht,
      Nat.mod_eq_of_lt hs] at hn
    omega
  simp [hneq]

