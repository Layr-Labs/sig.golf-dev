    (rv64_divu ((((n * (n - 1#64)) * (n - 2#64)) *
      (n - 3#64)) * (n - 4#64)) (120#64)).toNat = n.toNat.choose 5 := by
  change (rv64_divu (numerator5 n) (120#64)).toNat = n.toNat.choose 5
  have hs1 : (n - 1#64).toNat = n.toNat - 1 := subNat n 1 (by omega) (by decide)
  have hs2 : (n - 2#64).toNat = n.toNat - 2 := subNat n 2 (by omega) (by decide)
  have hs3 : (n - 3#64).toNat = n.toNat - 3 := subNat n 3 (by omega) (by decide)
  have hs4 : (n - 4#64).toNat = n.toNat - 4 := subNat n 4 (by omega) (by decide)
  have h1 : n.toNat * (n.toNat - 1) ≤ 384^2 := by
    exact Nat.mul_le_mul hhi (by omega)
  have h2 : (n.toNat * (n.toNat - 1)) * (n.toNat - 2) ≤ 384^3 := by
    calc
      _ ≤ (384^2)*(384) := Nat.mul_le_mul h1 (by omega)
      _ = 384^3 := by norm_num
  have h3 : ((n.toNat * (n.toNat - 1)) * (n.toNat - 2)) * (n.toNat - 3) ≤ 384^4 := by
    calc
      _ ≤ (384^3)*(384) := Nat.mul_le_mul h2 (by omega)
      _ = 384^4 := by norm_num
  have h4 : (((n.toNat * (n.toNat - 1)) * (n.toNat - 2)) * (n.toNat - 3)) * (n.toNat - 4) ≤ 384^5 := by
    calc
