    n.choose 5 = (((n*(n-1))*(n-2))*(n-3))*(n-4) / 120 := by
  rw [Nat.choose_eq_descFactorial_div_factorial]
  simp only [Nat.descFactorial, Nat.factorial, Nat.sub_zero]
  congr 1
  ring

