set_option maxHeartbeats 1000000

theorem search_phase (s : MachineState) (code lo : Nat)
    (hpc : s.pc = BitVec.ofNat 64 4184)
    (h10 : s.getReg .x10 = BitVec.ofNat 64 code)
    (h8 : s.getReg .x8 = BitVec.ofNat 64 lo)
    (h7 : s.getReg .x7 = BitVec.ofNat 64 0x20F0)
    (h2 : s.getReg .x2 = BitVec.ofNat 64 0xffc3d0)
    (hcap : code < Nat.choose 385 5)
    (htable : ∀ i < 5 * 385,
      s.getMem (BitVec.ofNat 64 (0xffc3d0 + 8 * i)) =
        BitVec.ofNat 64 (Nat.choose (i % 385) (i / 385 + 1))) :
    let b4 := Radix12.highChooseMax 5 384 code
    let r4 := code - Nat.choose b4 5
    let b3 := Radix12.highChooseMax 4 b4 r4
    let r3 := r4 - Nat.choose b3 4
    let b2 := Radix12.highChooseMax 3 b3 r3
    let r2 := r3 - Nat.choose b2 3
    let b1 := Radix12.highChooseMax 2 b2 r2
    let r1 := r2 - Nat.choose b1 2
    let b0 := Radix12.highChooseMax 1 b1 r1
    ∃ t n c, Steps expandImage s n c t ∧
      t.pc = BitVec.ofNat 64 4380 ∧ t.getReg .x10 = 0#64 ∧
      t.getReg .x7 = BitVec.ofNat 64 0x20F0 ∧
      t.getReg .x28 = BitVec.ofNat 64 0x4000 ∧
      t.getReg .x8 = BitVec.ofNat 64 lo ∧
      t.getReg .x26 = 4095#64 ∧
      t.getMem (slot 0) = BitVec.ofNat 64 b0 ∧
      t.getMem (slot 1) = BitVec.ofNat 64 b1 ∧
      t.getMem (slot 2) = BitVec.ofNat 64 b2 ∧
      t.getMem (slot 3) = BitVec.ofNat 64 b3 ∧
      t.getMem (slot 4) = BitVec.ofNat 64 b4 ∧
      readBuffer t 0x800 6384 = readBuffer s 0x800 6384 ∧
      n ≤ setup.res.steps + mask.res.steps +
        5 * (Radix12SplitStageStartSD.stage.res.steps + 117 +
          Radix12SplitStagePostSD.post.res.steps) ∧
      c ≤ setup.res.cycles + mask.res.cycles +
        5 * (Radix12SplitStageStartSD.stage.res.cycles + 144 +
          Radix12SplitStagePostSD.post.res.cycles) := by
  let b4 := Radix12.highChooseMax 5 384 code
  let r4 := code - Nat.choose b4 5
  let b3 := Radix12.highChooseMax 4 b4 r4
  let r3 := r4 - Nat.choose b3 4
  let b2 := Radix12.highChooseMax 3 b3 r3
  let r2 := r3 - Nat.choose b2 3
  let b1 := Radix12.highChooseMax 2 b2 r2
  let r1 := r2 - Nat.choose b1 2
  let b0 := Radix12.highChooseMax 1 b1 r1
  obtain ⟨w, hwsteps, hwin⟩ :=
    setup_to_stage s code hpc h10 h7 h2 hcap htable
  let a := setup.res.toState s
  let q := mask.res.toState a
  have haq : Steps expandImage s setup.res.steps setup.res.cycles a :=
    setup_steps s hpc
  have hapc : a.pc = BitVec.ofNat 64 4248 := setup_pc s code h10 hcap
  have hqm : Steps expandImage a mask.res.steps mask.res.cycles q :=
    mask_steps a hapc
  have hwq : w = q := Radix12SplitStepsDet.steps_det hwsteps (haq.trans hqm)
  have hwa8 : a.getReg .x8 = s.getReg .x8 := (setup_low s).1
  have hwa26 : a.getReg .x26 = 0xffffffff#64 := (setup_low s).2
  have hq8 : q.getReg .x8 = a.getReg .x8 := (mask_low a hwa26).1
  have hq26 : q.getReg .x26 = 4095#64 := (mask_low a hwa26).2
  have hw8 : w.getReg .x8 = BitVec.ofNat 64 lo := by
    rw [hwq, hq8, hwa8]
    exact h8
  have hw26 : w.getReg .x26 = 4095#64 := by rw [hwq]; exact hq26
  have hwbody : readBuffer w 0x800 6384 = readBuffer s 0x800 6384 := by
    rw [hwq]
    exact mem_eq_readBuffer (s := s) (t := q)
      (by intro x; rw [mask_mem, setup_mem]) 0x800 6384
  obtain ⟨t,n,c,htsteps,htpc,ht10,ht7,ht28,ht0,ht1,ht2,ht3,ht4,hn,hc,hframe⟩ :=
    five_stages w code hwin hcap
  have hlowframe := steps_frame htsteps ⟨39, by decide, by decide,
    by simpa only [here] using hwin.pc⟩
  have ht8 : t.getReg .x8 = BitVec.ofNat 64 lo := hlowframe.1.trans hw8
  have ht26 : t.getReg .x26 = 4095#64 := hlowframe.2.trans hw26
  refine ⟨t, setup.res.steps + mask.res.steps + n,
    setup.res.cycles + mask.res.cycles + c,
    hwsteps.trans htsteps, htpc, ht10, ht7, ht28, ht8, ht26,
    ht0,ht1,ht2,ht3,ht4, ?_, ?_, ?_⟩
  · exact (stage_body w t hframe).trans hwbody
  · omega
  · omega

#print axioms search_phase
end Radix12SplitSearchPhaseSD
end
