section

namespace Radix12SplitFrameLowSD
open RiscvZkvm.Rv64 SigGolfCandidate.Legacy SigGolfCandidate.Legacy.Riscv
  SigGolfCandidate.Rv SigGolfCandidate.Mem Radix12SplitExpandImageSD
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000

def insideB (pc : Word) : Bool :=
  decide (4252 ≤ pc.toNat ∧ pc.toNat ≤ 4588 ∧ pc.toNat % 4 = 0)

def here (i : Nat) : Word := BitVec.ofNat 64 (4096 + 4 * i)

def safeMicroB : Micro → Bool
  | .alu rd _ _ _ | .load _ rd _ _ | .jal rd _ | .jalr rd _ _ =>
      rd != .x8 && rd != .x26
  | .store .. | .branch .. => true

def nextSafeB (i : Nat) : Micro → Bool
  | .branch _ _ _ off => insideB (here i + off) && insideB (here i + 4)
  | .jal _ off => insideB (here i + off)
  | .jalr .. => false
  | _ => insideB (here i + 4)

def safeWordB (i : Nat) : Bool :=
  match expandCode[i]? with
  | none => false
  | some w =>
      match decodeInstruction w with
      | none => false
      | some instr =>
          match classify instr with
          | some m => safeMicroB m && nextSafeB i m
          | none => i == 123

def certB : Bool :=
  (List.range 85).all fun k => safeWordB (39 + k)

theorem cert : certB = true := by decide +kernel

theorem safe_at (i : Nat) (hlo : 39 ≤ i) (hhi : i ≤ 123) :
    safeWordB i = true := by
  have h := (List.all_eq_true.mp cert) (i - 39) (by
    simp only [List.mem_range]
    omega)
  simpa only [certB, Nat.add_sub_of_le hlo] using h

theorem frame_one (m : Micro) (s t : MachineState) (r : Reg)
    (hr : r = .x8 ∨ r = .x26)
    (hm : safeMicroB m = true)
    (hs : m.exec s = some t) :
    t.getReg r = s.getReg r := by
  cases m with
  | alu rd op a b =>
      have hrd : rd ≠ r := by
        simp only [safeMicroB, Bool.and_eq_true, bne_iff_ne] at hm
        rcases hr with rfl | rfl
        · exact hm.1
        · exact hm.2
      simp only [Micro.exec, Option.some.injEq] at hs
      subst t
      simp only [MachineState.getReg_setPC]
      exact MachineState.getReg_setReg_ne s rd r _ hrd
  | load k rd rs off =>
      have hrd : rd ≠ r := by
        simp only [safeMicroB, Bool.and_eq_true, bne_iff_ne] at hm
        rcases hr with rfl | rfl
        · exact hm.1
        · exact hm.2
      simp only [Micro.exec] at hs
      split_ifs at hs
      cases hs
      simp only [MachineState.getReg_setPC]
      exact MachineState.getReg_setReg_ne s rd r _ hrd
  | store k rs1 rs2 off =>
      simp only [Micro.exec] at hs
      split_ifs at hs
      cases hs
      cases k <;> rfl
  | branch op rs1 rs2 off =>
      simp only [Micro.exec] at hs
      split_ifs at hs <;> cases hs <;> rfl
  | jal rd off =>
      have hrd : rd ≠ r := by
        simp only [safeMicroB, Bool.and_eq_true, bne_iff_ne] at hm
        rcases hr with rfl | rfl
        · exact hm.1
        · exact hm.2
      simp only [Micro.exec, Option.some.injEq] at hs
      subst t
      simp only [MachineState.getReg_setPC]
      exact MachineState.getReg_setReg_ne s rd r _ hrd
  | jalr rd rs off =>
      have hrd : rd ≠ r := by
        simp only [safeMicroB, Bool.and_eq_true, bne_iff_ne] at hm
        rcases hr with rfl | rfl
        · exact hm.1
        · exact hm.2
      simp only [Micro.exec, Option.some.injEq] at hs
      subst t
      simp only [MachineState.getReg_setPC]
      exact MachineState.getReg_setReg_ne s rd r _ hrd

theorem next_inside (i : Nat) (m : Micro) (s t : MachineState)
    (hpc : s.pc = here i)
    (hn : nextSafeB i m = true)
    (hs : m.exec s = some t) :
    insideB t.pc = true := by
  cases m with
  | alu rd op a b =>
      simp only [Micro.exec, Option.some.injEq] at hs
      subst t
      simpa only [nextSafeB, pc_setPC, hpc] using hn
  | load k rd rs off =>
      simp only [Micro.exec] at hs
      split_ifs at hs
      cases hs
      simpa only [nextSafeB, pc_setPC, hpc] using hn
  | store k rs1 rs2 off =>
      simp only [Micro.exec] at hs
      split_ifs at hs
      cases hs
      simpa only [nextSafeB, pc_setPC, hpc] using hn
  | branch op rs1 rs2 off =>
      simp only [Micro.exec, Option.some.injEq] at hs
      subst t
      simp only [nextSafeB, Bool.and_eq_true] at hn
      by_cases hb : op.eval (s.getReg rs1) (s.getReg rs2) = true
      · simp only [hb, if_true, pc_setPC, hpc]
        exact hn.1
      · simp only [hb, if_false, pc_setPC, hpc]
        exact hn.2
  | jal rd off =>
      simp only [Micro.exec, Option.some.injEq] at hs
      subst t
      simpa only [nextSafeB, pc_setPC, hpc] using hn
  | jalr rd rs off =>
      simp only [nextSafeB] at hn
      cases hn

theorem inside_index (pc : Word) (h : insideB pc = true) :
    ∃ i : Nat, 39 ≤ i ∧ i ≤ 123 ∧ pc = here i := by
  simp only [insideB, decide_eq_true_eq] at h
  let i := (pc.toNat - 4096) / 4
  have hpc : pc = here i := by
    apply BitVec.eq_of_toNat_eq
    simp only [here, BitVec.toNat_ofNat]
    rw [Nat.mod_eq_of_lt (show 4096 + 4 * i < 2 ^ 64 by dsimp [i]; omega)]
    dsimp [i]
    omega
  refine ⟨i, ?_, ?_, hpc⟩ <;> dsimp [i] <;> omega

theorem fetch_safe (s : MachineState) (i : Nat) (instr : Instruction)
    (hlo : 39 ≤ i) (hhi : i ≤ 123)
    (hpc : s.pc = here i)
    (hf : fetch expandImage s = some instr) :
    (∃ m, classify instr = some m ∧ safeMicroB m = true ∧
      nextSafeB i m = true) ∨ instr = .base .ECALL := by
  have hidx : (s.pc.toNat - 4096) / 4 = i := by
    rw [hpc]
    simp only [here, BitVec.toNat_ofNat,
      Nat.mod_eq_of_lt (show 4096 + 4 * i < 2 ^ 64 by omega)]
    omega
  have hpcnat : s.pc.toNat = 4096 + 4 * i := by
    rw [hpc]
    simp only [here, BitVec.toNat_ofNat,
      Nat.mod_eq_of_lt (show 4096 + 4 * i < 2 ^ 64 by omega)]
  have hfetch : (expandCode[i]?).bind decodeInstruction = some instr := by
    unfold fetch at hf
    have hcond :
        (s.pc.toNat < 4096 || s.pc.toNat % 4 != 0) = false := by
      rw [hpcnat]
      simp
    simp only [hcond, Bool.false_eq_true, ↓reduceIte] at hf
    simpa [Option.bind, hidx, expandImage] using hf
  have hsafe := safe_at i hlo hhi
  unfold safeWordB at hsafe
  cases hw : expandCode[i]? with
  | none => simp [hw] at hsafe
  | some w =>
      cases hd : decodeInstruction w with
      | none => simp [hw, hd] at hsafe
      | some j =>
          have hji : j = instr := by simpa [hw, hd] using hfetch
          subst j
          cases hc : classify instr with
          | some m =>
              simp only [hw, hd, hc, Bool.and_eq_true] at hsafe
              exact Or.inl ⟨m, rfl, hsafe.1, hsafe.2⟩
          | none =>
              simp only [hw, hd, hc, beq_iff_eq] at hsafe
              have hw123 : expandCode[123]? = some (0x00000073 : BitVec 32) := by
                decide +kernel
              have hword : w = (0x00000073 : BitVec 32) := by
                rw [hsafe, hw123] at hw
                exact (Option.some.inj hw).symm
              rw [hword] at hd
              have hdec : decodeInstruction (0x00000073 : BitVec 32) =
                  some (.base .ECALL) := rfl
              rw [hdec] at hd
              exact Or.inr (Option.some.inj hd).symm

theorem steps_frame {s t : MachineState} {n c : Nat}
    (h : Steps expandImage s n c t)
    (hs : ∃ i : Nat, 39 ≤ i ∧ i ≤ 123 ∧ s.pc = here i) :
    t.getReg .x8 = s.getReg .x8 ∧
    t.getReg .x26 = s.getReg .x26 := by
  induction h with
  | refl => exact ⟨rfl, rfl⟩
  | @step s u t instr k c hf ho tail ih =>
      obtain ⟨i, hlo, hhi, hpc⟩ := hs
      rcases fetch_safe s i instr hlo hhi hpc hf with
        ⟨m, hclass, hsafe, hnext⟩ | hecall
      · rw [classify_sound hclass s] at ho
        have hu8 := frame_one m s u .x8 (Or.inl rfl) hsafe ho
        have hu26 := frame_one m s u .x26 (Or.inr rfl) hsafe ho
        have hinside := next_inside i m s u hpc hnext ho
        obtain ⟨j, hjlo, hjhi, hjpc⟩ := inside_index u.pc hinside
        obtain ⟨ht8, ht26⟩ := ih ⟨j, hjlo, hjhi, hjpc⟩
        exact ⟨ht8.trans hu8, ht26.trans hu26⟩
      · subst instr
        exact False.elim (ordinaryStep_ne_ecall ho rfl)

#print axioms steps_frame

#print axioms cert
#print axioms safe_at
end Radix12SplitFrameLowSD
end
