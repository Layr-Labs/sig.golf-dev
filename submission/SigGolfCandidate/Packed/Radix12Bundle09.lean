theorem highCode_trailer (p : BitVec 96) :
    Radix12Split.highCode p.toNat = (p.extractLsb' 60 36).toNat := by
  unfold Radix12Split.highCode
  rw [BitVec.extractLsb'_toNat, Nat.shiftRight_eq_div_pow]
  have hp : p.toNat / 2 ^ 60 < 2 ^ 36 := by
    have h := p.isLt
    omega
  exact (Nat.mod_eq_of_lt hp).symm

theorem fallback_phase (v : MachineState) (p : BitVec 96)
    (hpc : v.pc = BitVec.ofNat 64 4184)
    (h10 : v.getReg .x10 = BitVec.ofNat 64
      (p.extractLsb' 60 36).toNat)
    (h6 : v.getReg .x6 = BitVec.ofNat 64 0x3F40)
    (h7 : v.getReg .x7 = BitVec.ofNat 64 0x20F0)
    (htr : trailer96 v = p)
    (hcap : Nat.choose 385 5 ≤ (p.extractLsb' 60 36).toNat) :
    ∃ u, Steps expandImage v
        (setup.res.steps + fallback.res.steps + done.res.steps)
        (setup.res.cycles + fallback.res.cycles + done.res.cycles) u ∧
      fetch expandImage u = some (.base .ECALL) ∧
      u.getReg .x5 = 1 ∧ u.getReg .x10 = 0 ∧
      readBuffer u 0x800 6404 =
        Radix12Split.expandSplit p ++ readBuffer v 0x800 6384 := by
  let a := setup.res.toState v
  let b := fallback.res.toState a
  let u := done.res.toState b
  have hs : Steps expandImage v setup.res.steps setup.res.cycles a :=
    setup_steps v hpc
  have hpc_a : a.pc = BitVec.ofNat 64 4544 :=
    setup_pc_invalid v _ h10 hcap (p.extractLsb' 60 36).isLt
  have h6a : a.getReg .x6 = 0x3F40 := by
    simp only [a, Result.toState_getReg, setup.res, rv_simp]
    exact h6
  have h7a : a.getReg .x7 = 0x20F0 := by
    have hh := setup_regs v
    exact hh.2.2.2.2.2.1.trans h7
  have htr_a : trailer96 a = p := by
    have he : trailer96 a = trailer96 v := by
      simp only [trailer96, trailerHi, trailerLo, a, setup_mem]
    exact he.trans htr
  have hbody_a : readBuffer a 0x800 6384 = readBuffer v 0x800 6384 :=
    Radix12SplitBodyBridgeSD.mem_eq_readBuffer (s := v) (t := a)
      (setup_mem v) 0x800 6384
  have hf : Steps expandImage a fallback.res.steps fallback.res.cycles b :=
    fallback_steps a hpc_a h6a h7a
  obtain ⟨hd,hfetch,h5,h10u⟩ := done_steps b (fallback_pc a)
  have hbuf : readBuffer b 0x800 6404 =
      fallbackCounters a ++ readBuffer a 0x800 6384 :=
    fallback_readBuffer a h6a h7a
  have hdmem : readBuffer u 0x800 6404 = readBuffer b 0x800 6404 :=
    Radix12SplitBodyBridgeSD.mem_eq_readBuffer (s := b) (t := u)
      (done_mem b) 0x800 6404
  have hdecode : Radix12Split.expandSplit p =
      Radix12.encodeWords (Radix12.badWords p.toNat) := by
    unfold Radix12Split.expandSplit
    rw [decode_bad ⟨p.toNat, p.isLt⟩ (by rw [highCode_trailer]; exact hcap)]
  refine ⟨u, Steps.of_eq ((hs.trans hf).trans hd) (by omega) (by omega),
    hfetch, h5, h10u, ?_⟩
  rw [hdmem, hbuf, fallbackCounters_eq, htr_a, ← hdecode, hbody_a]

#print axioms highCode_trailer
#print axioms fallback_phase
end Radix12SplitFallbackPhaseSD
