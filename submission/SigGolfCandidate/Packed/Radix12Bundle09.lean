set_option maxHeartbeats 1000000

theorem start_invalid_refined (m : Message) (pk : PublicKey)
    (σ : Bytes 6396) :
    let p := Radix12Split.trailer σ
    let code := (p.extractLsb' 60 36).toNat
    ∃ v, Steps expandImage (Radix12SplitInitTable.initState m pk σ)
        (runPre.res.steps + 1596 * 6 + runCtr.res.steps + first7.res.steps)
        (runPre.res.cycles + 1596 * 6 + runCtr.res.cycles + first7.res.cycles) v ∧
      v.pc = BitVec.ofNat 64 4184 ∧
      v.getReg .x10 = BitVec.ofNat 64 code ∧
      v.getReg .x6 = BitVec.ofNat 64 0x3F40 ∧
      v.getReg .x7 = BitVec.ofNat 64 0x20F0 ∧
      Radix12SplitExpandLoadedSD.trailer96 v = p ∧
      readBuffer v 0x800 6384 = Radix12Split.body σ := by
  let t := Radix12SplitInitTable.initState m pk σ
  obtain ⟨v,hstep,hpc,h10,_h8,_h2,h7,_htable,hbody⟩ :=
    Radix12SplitStartRefinedSD.start_refined m pk σ
  have htpc : t.pc = 0x1000 := by
    simp only [t, Radix12SplitInitTable.initState, MachineState.pc_setReg,
      MachineState.pc_writeBytesAsWords]
  obtain ⟨u,hstage,hupc,hcopy⟩ :=
    body_stage t htpc (fun a => t.getByte (BitVec.ofNat 64 a))
      (by intro a ha; rfl)
  obtain ⟨hctr,h6c,hcpc⟩ := ctr_steps u hupc
  let c := runCtr.res.toState u
  let v' := first7.res.toState c
  have hfirst : Steps expandImage c first7.res.steps first7.res.cycles v' :=
    first7_steps c hcpc h6c
  have hstep' : Steps expandImage t
      (runPre.res.steps + 1596 * 6 + runCtr.res.steps + first7.res.steps)
      (runPre.res.cycles + 1596 * 6 + runCtr.res.cycles + first7.res.cycles) v' :=
    Steps.of_eq (hstage.trans (hctr.trans hfirst)) (by omega) (by omega)
  have heq : v = v' := Radix12SplitStepsDet.steps_det hstep hstep'
  subst v
  have h6 : v'.getReg .x6 = 0x3F40 := by
    simp only [v', Result.toState_getReg, first7.res, rv_simp]
    exact h6c
  have hvtr : Radix12SplitExpandLoadedSD.trailer96 v' =
      Radix12SplitExpandLoadedSD.trailer96 c := by
    simp only [Radix12SplitExpandLoadedSD.trailer96,
      Radix12SplitExpandLoadedSD.trailerHi,
      Radix12SplitExpandLoadedSD.trailerLo, v', first7_mem]
  have hcutr : Radix12SplitExpandLoadedSD.trailer96 c =
      Radix12SplitExpandLoadedSD.trailer96 u := by
    simp only [Radix12SplitExpandLoadedSD.trailer96,
      Radix12SplitExpandLoadedSD.trailerHi,
      Radix12SplitExpandLoadedSD.trailerLo, c, ctr_mem]
  have hut : Radix12SplitExpandLoadedSD.trailer96 u =
      Radix12Split.trailer σ :=
    (trailer_preserved_copy t u hcopy).trans (initState_trailer m pk σ)
  exact ⟨v',hstep,hpc,h10,h6,h7,hvtr.trans (hcutr.trans hut),hbody⟩

#print axioms start_invalid_refined
end Radix12SplitFallbackStartSD
