    (h6 : s.getReg .x6 = BitVec.ofNat 64 0x20F0)
    (hr : reservedMarker (Radix27SignLoaded.q s)) :
    (second s).pc = BitVec.ofNat 64 (0x1000 + 4*2973) := by
