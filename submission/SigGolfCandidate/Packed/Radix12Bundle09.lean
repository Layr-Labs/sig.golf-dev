      alignToDword (BitVec.ofNat 64 (0x800 + j)) ≠ BitVec.ofNat 64 x := by
    intro h
    rw [h] at ha
    rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hxb] at ha
    omega
  simp only [MachineState.getByte]
  rw [fallback_mem_frame s _ h7 (hne _ (by omega) (by decide))
    (hne _ (by omega) (by decide)) (hne _ (by omega) (by decide))]

#print axioms fallback_body_byte

theorem fallback_counter_byte (s : MachineState)
    (h6 : s.getReg .x6 = 0x3F40)
    (h7 : s.getReg .x7 = 0x20F0)
    (j : Nat) (hj : j < 20) :
    (fallback.res.toState s).getByte (BitVec.ofNat 64 (0x20F0 + j)) =
      (fallbackCounters s).extractLsb' (8 * j) 8 := by
  have ha : alignToDword (BitVec.ofNat 64 (0x20F0 + j)) =
      BitVec.ofNat 64 (0x20F0 + 8 * (j / 8)) := by
    apply BitVec.eq_of_toNat_eq
    rw [alignToDword_toNat]
    simp only [BitVec.toNat_ofNat]
    omega
  have hb : byteOffset (BitVec.ofNat 64 (0x20F0 + j)) = j % 8 := by
    rw [byteOffset_ofNat (by omega)]
    omega
  simp only [MachineState.getByte]
  rw [ha, hb]
  by_cases hj0 : j < 8
  · have hd : j / 8 = 0 := by omega
    have hm : j % 8 = j := by omega
    simp only [hd, hm, Nat.mul_zero, Nat.add_zero]
    rw [fallback_word0 s h6 h7, byteExtract, ← fallback_out_word0]
    simpa only [Nat.zero_add] using
      nestedExtract (fallbackCounters s) 0 64 (8 * j) 8 (by omega)
  · by_cases hj1 : j < 16
    · have hd : j / 8 = 1 := by omega
      have hm : j % 8 = j - 8 := by omega
      simp only [hd, hm, Nat.mul_one, Nat.reduceAdd]
      rw [fallback_word1 s h6 h7, byteExtract, ← fallback_out_word1]
      rw [nestedExtract (fallbackCounters s) 64 64 (8 * (j - 8)) 8 (by omega)]
      congr 1
      omega
    · have hd : j / 8 = 2 := by omega
      have hm : j % 8 = j - 16 := by omega
      simp only [hd, hm, Nat.reduceMul, Nat.reduceAdd]
      let x := (fallback.res.toState s).getMem (BitVec.ofNat 64 0x2100)
      calc
        extractByte x (j - 16) =
            (x.extractLsb' 0 32).extractLsb' (8 * (j - 16)) 8 := by
          rw [byteExtract]
          simpa only [Nat.zero_add] using
            (nestedExtract x 0 32 (8 * (j - 16)) 8 (by omega)).symm
        _ = ((fallbackCounters s).extractLsb' 128 32).extractLsb'
            (8 * (j - 16)) 8 := by
          exact congrArg (fun v : BitVec 32 => v.extractLsb' (8 * (j - 16)) 8)
            ((fallback_word2 s h7).trans (fallback_out_word2 s).symm)
        _ = (fallbackCounters s).extractLsb' (8 * j) 8 := by
          rw [nestedExtract (fallbackCounters s) 128 32 (8 * (j - 16)) 8 (by omega)]
          congr 1
          omega

#print axioms fallback_counter_byte

end Radix12SplitFallbackBytesSD
