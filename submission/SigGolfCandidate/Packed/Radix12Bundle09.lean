theorem trailer_high_byte (u : MachineState)
    (h7 : u.getReg .x7 = BitVec.ofNat 64 0x3F40)
    (hx : (u.getReg .x17).toNat < 65536)
    (j : Nat) (hj : j < 5) :
    (signTrailer.res.toState u).getByte (BitVec.ofNat 64 (0x3F48 + j)) =
