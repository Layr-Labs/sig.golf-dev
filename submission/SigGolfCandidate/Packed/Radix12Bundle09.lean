    (replaceWord32 (u.getMem (BitVec.ofNat 64 0x3F48)) 0
      ((u.getReg .x14 <<< 16 ||| u.getReg .x17).truncate 32))
    4 ((u.getReg .x14 >>> 16).truncate 8)

