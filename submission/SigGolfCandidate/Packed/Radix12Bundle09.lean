theorem highRank_lt_cap (w : Counter5)
    (h : counterSum (highWords w) < 381) :
    highRank w < Nat.choose 385 5 := by
  have h01 : bar0 (highWords w).c0 <
      bar1 (highWords w).c0 (highWords w).c1 := by simp [bar0, bar1]
  have h12 : bar1 (highWords w).c0 (highWords w).c1 <
      bar2 (highWords w).c0 (highWords w).c1 (highWords w).c2 := by
    simp [bar1, bar2]
  have h23 : bar2 (highWords w).c0 (highWords w).c1 (highWords w).c2 <
      bar3 (highWords w).c0 (highWords w).c1 (highWords w).c2
        (highWords w).c3 := by simp [bar2, bar3]
  have h34 : bar3 (highWords w).c0 (highWords w).c1 (highWords w).c2
      (highWords w).c3 <
      bar4 (highWords w).c0 (highWords w).c1 (highWords w).c2
        (highWords w).c3 (highWords w).c4 := by simp [bar3, bar4]
  have hrank := (rank5_interval h01 h12 h23 h34).2
  have hb : bar4 (highWords w).c0 (highWords w).c1 (highWords w).c2
      (highWords w).c3 (highWords w).c4 + 1 ≤ 385 := by
    simp only [bar4, counterSum] at h ⊢
    omega
  exact lt_of_lt_of_le hrank (Nat.choose_le_choose 5 hb)

theorem decode_bad (p : Fin (2 ^ 96))
    (hcap : Nat.choose 385 5 ≤ highCode p.val) :
    Radix12Split.decode p = badWords p.val := by
  have hneg : ¬(counterSum (highWords (decodedValue p.val)) < 381 ∧
      rankValue (decodedValue p.val) = p.val) := by
    intro h
    have hlt := highRank_lt_cap (decodedValue p.val) h.1
    have hc := highCode_rankValue (decodedValue p.val)
    rw [h.2] at hc
    omega
  change (if counterSum (highWords (decodedValue p.val)) < 381 ∧
      rankValue (decodedValue p.val) = p.val then
        decodedValue p.val else badWords p.val) = badWords p.val
  exact if_neg hneg

theorem chunk (p : BitVec 96) (k : Nat) :
    BitVec.ofNat 32 ((p.toNat / 2 ^ k) % 2 ^ 32) =
      p.extractLsb' k 32 := by
  apply BitVec.eq_of_toNat_eq
  simp only [BitVec.toNat_ofNat, BitVec.extractLsb'_toNat,
    Nat.shiftRight_eq_div_pow]
  exact Nat.mod_mod _ _

theorem trailer_chunk0 (s : RiscvZkvm.Rv64.MachineState) :
    (trailer96 s).extractLsb' 0 32 =
      extractWord32 (s.getMem 0x3F40) 0 := by
  unfold trailer96 trailerHi trailerLo extractWord32
  bv_normalize

theorem trailer_chunk1 (s : RiscvZkvm.Rv64.MachineState) :
    (trailer96 s).extractLsb' 32 32 =
      extractWord32 (s.getMem 0x3F40) 1 := by
  unfold trailer96 trailerHi trailerLo extractWord32
  bv_normalize

theorem trailer_chunk2 (s : RiscvZkvm.Rv64.MachineState) :
    (trailer96 s).extractLsb' 64 32 =
      extractWord32 (s.getMem 0x3F48) 0 := by
  unfold trailer96 trailerHi trailerLo extractWord32
  bv_normalize

theorem fallbackCounters_eq (s : RiscvZkvm.Rv64.MachineState) :
    fallbackCounters s =
      encodeWords (badWords (trailer96 s).toNat) := by
  simp only [fallbackCounters, encodeWords, badWords]
  have h0 := chunk (trailer96 s) 0
  simp only [Nat.pow_zero, Nat.div_one] at h0
  rw [h0, chunk (trailer96 s) 32, chunk (trailer96 s) 64]
  rw [trailer_chunk0, trailer_chunk1, trailer_chunk2]
  have hc : (4194304#32) = BitVec.ofNat 32 (2 ^ 22) := by decide
  simp only [BitVec.append_assoc, BitVec.cast_eq, hc]

#print axioms decode_bad
#print axioms chunk
#print axioms fallbackCounters_eq
end Radix12SplitFallbackCodecSD
