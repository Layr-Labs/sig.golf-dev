theorem toList_join (s : MachineState) :
    toList (n := 6404) ((fallbackCounters s) ++ readBuffer s 0x800 6384) =
      toList (readBuffer s 0x800 6384) ++
        toList (n := 20) (fallbackCounters s) := by
  exact toList_concat (n := 6384) (m := 20)
    (readBuffer s 0x800 6384) (fallbackCounters s)

theorem fallback_readBuffer (s : MachineState)
    (h6 : s.getReg .x6 = 0x3F40)
    (h7 : s.getReg .x7 = 0x20F0) :
    readBuffer (fallback.res.toState s) 0x800 6404 =
      (fallbackCounters s) ++ readBuffer s 0x800 6384 := by
  apply readBuffer_eq_of_bytes
  intro i hi
  rw [toList_join]
  by_cases hb : i < 6384
  · rw [fallback_body_byte s h7 i hb]
    rw [List.getD_eq_getElem?_getD,
      List.getElem?_append_left (by rw [length_toList]; exact hb)]
    exact (readBuffer_byte s 0x800 6384 i hb).symm
  · have hj : i - 6384 < 20 := by omega
    have heq : 0x800 + i = 0x20F0 + (i - 6384) := by omega
    rw [heq, fallback_counter_byte s h6 h7 (i - 6384) hj]
    rw [List.getD_eq_getElem?_getD,
      List.getElem?_append_right (by rw [length_toList]; omega),
      length_toList]
    simpa only [List.getD_eq_getElem?_getD, SigGolfCandidate.Ref.toList] using
      (getD_bytes (fallbackCounters s) (i - 6384) hj).symm

#print axioms fallback_readBuffer
