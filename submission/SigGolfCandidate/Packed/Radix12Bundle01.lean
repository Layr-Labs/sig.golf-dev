  by_cases h : n ≤ c
  · simp only [if_pos h]
    have hnot : c ∉ Finset.range n := by simp [Finset.mem_range]; omega
    simp only [Finset.sum_ite_eq, hnot, if_false, add_zero]
  · have hmem : c ∈ Finset.range n := by simp [Finset.mem_range]; omega
    simp only [if_neg h, Finset.sum_ite_eq, hmem, if_true, zero_add]

theorem probEvent_bind_natClass_le {α β : Type}
    (mx : ProbComp α) (my : α → ProbComp β) (p : β → Prop)
    (c : α → Nat) (n : Nat) (f : Nat → ℝ≥0∞)
    (h : ∀ x ∈ support mx, c x < n → Pr[p | my x] ≤ f (c x)) :
    Pr[p | mx >>= my] ≤
      Pr[fun x => n ≤ c x | mx] +
        ∑ j ∈ Finset.range n, Pr[fun x => c x = j | mx] * f j := by
  classical
  rw [probEvent_bind_eq_tsum]
  calc
    (∑' x, Pr[= x | mx] * Pr[p | my x]) ≤
        ∑' x, Pr[= x | mx] *
          ((if n ≤ c x then (1 : ℝ≥0∞) else 0) +
            ∑ j ∈ Finset.range n, if c x = j then f j else 0) := by
      apply ENNReal.tsum_le_tsum
      intro x
      by_cases hx : x ∈ support mx
      · rw [← natClass_indicator_decomp (c x) n f]
        by_cases hc : n ≤ c x
        · simpa only [if_pos hc] using
            (mul_le_mul' (le_refl (Pr[= x | mx]))
              (probEvent_le_one : Pr[p | my x] ≤ 1))
        · simpa only [if_neg hc] using
            (mul_le_mul' (le_refl (Pr[= x | mx])) (h x hx (by omega)))
      · simp [probOutput_eq_zero_of_not_mem_support hx]
    _ = Pr[fun x => n ≤ c x | mx] +
          ∑ j ∈ Finset.range n, Pr[fun x => c x = j | mx] * f j := by
      simp_rw [mul_add]
      rw [ENNReal.tsum_add, tsum_probOutput_mul_finsetSum]
      congr 1
      · simp_rw [mul_ite, mul_one, mul_zero]
        rw [probEvent_eq_tsum_ite]
      · apply Finset.sum_congr rfl
        intro j hj
        have hterm (x : α) : Pr[= x | mx] * (if c x = j then f j else 0) =
            (if c x = j then Pr[= x | mx] else 0) * f j := by
          split_ifs <;> simp
        simp_rw [hterm]
        rw [ENNReal.tsum_mul_right, probEvent_eq_tsum_ite]

