def layerCounterSum : Nat → (Layer → LayerOutput) → Nat
  | 0, _ => 0
  | r + 1, parts =>
      if h : r < numLayers then
        (parts ⟨r, h⟩).1.toNat + layerCounterSum r parts
      else 0

def LayerSumSmall (n cut : Nat) (out : Option (Layer → LayerOutput)) : Prop :=
  ∃ parts, out = some parts ∧ layerCounterSum n parts < cut

def TopSumSmall (cut : Nat) (out : Option LayerOutput) : Prop :=
  ∃ part, out = some part ∧ part.1.toNat < cut

theorem layerCounterSum_congr (n : Nat) (f g : Layer → LayerOutput)
    (h : ∀ lay : Layer, lay.val < n → f lay = g lay) :
    layerCounterSum n f = layerCounterSum n g := by
  induction n with
  | zero => rfl
  | succ r ih =>
      unfold layerCounterSum
      split
      next hr =>
        rw [h ⟨r, hr⟩ (by simp), ih (fun lay hl => h lay (by omega))]
      next _ => rfl

theorem layerCounterSum_wrapped (r : Nat) (hr : r < numLayers)
    (counter : Counter) (values : ChainIndex → Digest)
    (path : Nat → Digest) (rest : Layer → LayerOutput) :
    layerCounterSum (r + 1) (fun other =>
      if other = (⟨r, hr⟩ : Layer) then (counter, values, path) else rest other) =
      counter.toNat + layerCounterSum r rest := by
  rw [layerCounterSum]
  simp only [dif_pos hr, if_pos rfl]
  congr 1
  apply layerCounterSum_congr
  intro lay hl
  have hne : lay ≠ (⟨r, hr⟩ : Layer) := by
    intro heq
    have hv := congrArg Fin.val heq
    simp only at hv
    omega
  simp only [if_neg hne]

theorem layerSumSmall_wrapped_iff (r : Nat) (hr : r < numLayers)
    (counter : Counter) (values : ChainIndex → Digest)
    (path : Nat → Digest) (rest : Layer → LayerOutput)
    (cut : Nat) (hcounter : counter.toNat < cut) :
    LayerSumSmall (r + 1) cut (some (fun other =>
      if other = (⟨r, hr⟩ : Layer) then (counter, values, path) else rest other)) ↔
      LayerSumSmall r (cut - counter.toNat) (some rest) := by
  constructor
  · rintro ⟨parts, hparts, hsum⟩
    have heq := Option.some.inj hparts
    subst parts
    refine ⟨rest, rfl, ?_⟩
    rw [layerCounterSum_wrapped] at hsum
    omega
  · rintro ⟨parts, hparts, hsum⟩
    have heq := Option.some.inj hparts
    subst parts
    refine ⟨_, rfl, ?_⟩
    rw [layerCounterSum_wrapped]
    omega

#print axioms layerCounterSum_wrapped
#print axioms layerSumSmall_wrapped_iff
end SphincsSecurity.Completeness
end
-- END Radix12LayerSum

-- BEGIN Radix12Top from /tmp/Radix12Top.lean
section

open OracleComp OracleSpec ENNReal
namespace SphincsSecurity.Completeness
open Concrete TargetSum

theorem topSumSmall_layer (counter : Counter)
    (values : ChainIndex → Digest) (path : Nat → Digest)
    (cut : Nat) (hcounter : counter.toNat < cut) :
    LayerSumSmall 1 cut (some fun other =>
      if other = topLayer then (counter, values, path)
      else (0, fun _ => 0, fun _ => 0)) := by
  refine ⟨_, rfl, ?_⟩
  rw [layerCounterSum]
  simp only [dif_pos (show 0 < numLayers by decide)]
  simpa [topLayer, layerCounterSum] using hcounter

set_option maxRecDepth 10000
set_option maxHeartbeats 300000
theorem probEvent_signTopLayerPaired_notSumSmall
    (parameter : PublicParameter) (index : Index)
    (secret : LeafIndex → ChainPair → OracleComp HashSpec (Digest × Digest))
    (topNode : Nat → Nat → OracleComp HashSpec Digest)
    (message : Digest) (cache : QueryCache HashSpec)
    (cut : Nat) (hcut : cut ≤ encodingAttemptLimit)
    (hfresh : EncodingFresh parameter (fun l => l.val < 1) cache) :
    Pr[fun r => ¬ TopSumSmall cut r.1 |
      (simulateQ randomOracle
        (signTopLayerPaired parameter index secret topNode message)).run cache] ≤
      failMass (fun out => decodeDigest (truncateHash out)) ^ cut := by
  rw [signTopLayerPaired]
  refine le_trans (probEvent_bind_le_add _ _
    (encodingAtLeast cut)
    (fun r => ¬ TopSumSmall cut r.1) cache 0 ?_) ?_
  · rintro ⟨result, c1⟩ _ hgood
    cases result with
    | none =>
        exact (hgood (by simp [encodingAtLeast])).elim
    | some pair =>
        obtain ⟨counter, encoding⟩ := pair
        have hcounter : counter.toNat < cut := by
          have hnot : ¬ cut ≤ counter.toNat := by
            simpa [encodingAtLeast] using hgood
          omega
        dsimp only
        refine probEvent_bind_le _ _ _ c1 0 (fun r1 _ => ?_)
        refine probEvent_bind_le _ _ _ r1.2 0 (fun r2 _ => ?_)
        simp [TopSumSmall, hcounter]
  · rw [add_zero]
    exact encodingAtLeast_le parameter _ _ _ message cache cut hcut
      (fun c _ => hfresh topLayer (by decide) _ _ _)

#print axioms probEvent_signTopLayerPaired_notSumSmall
end SphincsSecurity.Completeness
end
-- END Radix12Top

-- BEGIN Radix12Recurrence from /tmp/Radix12Recurrence.lean
section

open ENNReal
namespace SphincsSecurity.Completeness

noncomputable def layerTailBound (q : ℝ≥0∞) (n cut : Nat) : ℝ≥0∞ :=
  (n : ℝ≥0∞) * (cut : ℝ≥0∞) ^ (n - 1) * q ^ cut

set_option maxHeartbeats 300000
theorem layerTailBound_recurrence (q : ℝ≥0∞) (r cut : Nat)
    (hr : 1 ≤ r) (hcut : 1 ≤ cut) :
    q ^ cut + ∑ j ∈ Finset.range cut,
      q ^ j * layerTailBound q r (cut - j) ≤
      layerTailBound q (r + 1) cut := by
  have hterm (j : Nat) (hj : j < cut) :
      q ^ j * layerTailBound q r (cut - j) ≤
      (r : ℝ≥0∞) * (cut : ℝ≥0∞) ^ (r - 1) * q ^ cut := by
    unfold layerTailBound
    have hpow : q ^ j * q ^ (cut - j) = q ^ cut := by
      rw [← pow_add, Nat.add_sub_of_le (by omega : j ≤ cut)]
    have hbase : ((cut - j : Nat) : ℝ≥0∞) ≤ (cut : ℝ≥0∞) := by
      exact_mod_cast Nat.sub_le cut j
    have hpower : ((cut - j : Nat) : ℝ≥0∞) ^ (r - 1) ≤
        (cut : ℝ≥0∞) ^ (r - 1) := pow_le_pow_left₀ (by positivity) hbase _
    calc
      q ^ j * layerTailBound q r (cut - j) =
          (r : ℝ≥0∞) * ((cut - j : Nat) : ℝ≥0∞) ^ (r - 1) * q ^ cut := by
            unfold layerTailBound
            rw [← hpow]
            ring
      _ ≤ (r : ℝ≥0∞) * (cut : ℝ≥0∞) ^ (r - 1) * q ^ cut := by
            exact mul_le_mul' (mul_le_mul' le_rfl hpower) le_rfl
  have hsum :
      (∑ j ∈ Finset.range cut, q ^ j * layerTailBound q r (cut - j)) ≤
      (cut : ℝ≥0∞) * ((r : ℝ≥0∞) * (cut : ℝ≥0∞) ^ (r - 1) * q ^ cut) := by
    calc
      _ ≤ ∑ _j ∈ Finset.range cut,
        ((r : ℝ≥0∞) * (cut : ℝ≥0∞) ^ (r - 1) * q ^ cut) := by
          apply Finset.sum_le_sum
          intro j hj
          exact hterm j (Finset.mem_range.mp hj)
      _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]; simp
  have hcutpow : (1 : ℝ≥0∞) ≤ (cut : ℝ≥0∞) ^ r := by
    exact one_le_pow₀ (by exact_mod_cast hcut)
  unfold layerTailBound
  have hpowr : (cut : ℝ≥0∞) ^ r =
      (cut : ℝ≥0∞) * (cut : ℝ≥0∞) ^ (r - 1) := by
    calc
      (cut : ℝ≥0∞) ^ r = (cut : ℝ≥0∞) ^ ((r - 1) + 1) := by
        congr 1
        omega
      _ = (cut : ℝ≥0∞) * (cut : ℝ≥0∞) ^ (r - 1) := by
        rw [pow_succ]
        ring
  rw [show r + 1 - 1 = r by omega]
  calc
    q ^ cut + (∑ j ∈ Finset.range cut,
      q ^ j * ((r : ℝ≥0∞) * (↑(cut - j) : ℝ≥0∞) ^ (r - 1) * q ^ (cut - j))) ≤
        q ^ cut + (cut : ℝ≥0∞) *
          ((r : ℝ≥0∞) * (cut : ℝ≥0∞) ^ (r - 1) * q ^ cut) :=
      add_le_add le_rfl hsum
    _ = q ^ cut + (r : ℝ≥0∞) * (cut : ℝ≥0∞) ^ r * q ^ cut := by
      rw [hpowr]; ring
    _ ≤ (cut : ℝ≥0∞) ^ r * q ^ cut +
        (r : ℝ≥0∞) * (cut : ℝ≥0∞) ^ r * q ^ cut :=
      add_le_add_left (by simpa using mul_le_mul_left hcutpow (q ^ cut)) _
    _ = ((r + 1 : Nat) : ℝ≥0∞) * (cut : ℝ≥0∞) ^ r * q ^ cut := by
      push_cast
      ring

#print axioms layerTailBound_recurrence
end SphincsSecurity.Completeness
end
-- END Radix12Recurrence
