  relabel toHD (game12 seed message)

theorem relabel_val_game12HD (seed : MasterSeed)
    (message : SphincsSecurity.Message) :
    relabel Subtype.val (game12HD seed message) = game12 seed message := by
  unfold game12HD
  rw [relabel_relabel]
  exact Bridge.relabel_eq_self_of_allQ Equiv.Honest _ (fun x hx => val_toHD x hx)
    (hq_game12 seed message)

theorem probOutput_game12HD_false_le (seed : MasterSeed)
    (message : SphincsSecurity.Message) :
    Pr[= false | (simulateQ randomOracle (game12HD seed message)).run' ∅] ≤
      (2⁻¹ : ℝ≥0∞) ^ 1023 + (2⁻¹ : ℝ≥0∞) ^ 516 := by
  rw [run'_relabel Subtype.val Subtype.val_injective (game12HD seed message) ∅ ∅
    (fun _ => rfl), relabel_val_game12HD]
