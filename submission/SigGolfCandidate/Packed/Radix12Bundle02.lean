section

set_option maxRecDepth 10000
set_option maxHeartbeats 400000

namespace Radix12

structure Counter5 where
  c0 : Nat
  c1 : Nat
  c2 : Nat
  c3 : Nat
  c4 : Nat
deriving Repr

theorem Counter5.ext {a b : Counter5}
    (h0 : a.c0 = b.c0) (h1 : a.c1 = b.c1) (h2 : a.c2 = b.c2)
    (h3 : a.c3 = b.c3) (h4 : a.c4 = b.c4) : a = b := by
  cases a
  cases b
  simp_all

def counterSum (w : Counter5) : Nat := w.c0 + w.c1 + w.c2 + w.c3 + w.c4
def counterRank (w : Counter5) : Nat := packRank w.c0 w.c1 w.c2 w.c3 w.c4

def badWords (code : Nat) : Counter5 :=
  ⟨2 ^ 22, code % 2 ^ 32, (code / 2 ^ 32) % 2 ^ 32,
    (code / 2 ^ 64) % 2 ^ 32, 0⟩

def badPayload (w : Counter5) : Nat :=
  (w.c1 + 2 ^ 32 * w.c2 + 2 ^ 64 * w.c3) % 2 ^ 96

def encode (w : Counter5) : Nat :=
  if w.c0 < 2 ^ 22 ∧ counterSum w < 1565526 then counterRank w
  else badPayload w

theorem encode_lt (w : Counter5) : encode w < 2 ^ 96 := by
  unfold encode
  split_ifs with h
  · exact packRank_lt_96bits h.2
  · exact Nat.mod_lt _ (by decide)

noncomputable def decode (code : Fin (2 ^ 96)) : Counter5 :=
  by
    classical
    exact if h : ∃ w : Counter5, counterSum w < 1565526 ∧ counterRank w = code.val then
      Classical.choose h
    else badWords code.val

theorem decode_encode (code : Fin (2 ^ 96)) : encode (decode code) = code.val := by
  unfold decode
  split_ifs with h
  · obtain ⟨hsum, hrank⟩ := Classical.choose_spec h
    have hc0 : (Classical.choose h).c0 < 2 ^ 22 := by
      have hle : (Classical.choose h).c0 ≤ counterSum (Classical.choose h) := by
        simp only [counterSum]
        omega
      exact lt_trans (lt_of_le_of_lt hle hsum) (by decide)
    exact (if_pos ⟨hc0, hsum⟩).trans hrank
  · have hb : encode (badWords code.val) = badPayload (badWords code.val) := by
      simp [encode, badWords]
    rw [hb]
    simp only [badPayload, badWords]
    have hcode := code.isLt
    norm_num at hcode ⊢
    omega

theorem badWords_invalid (code : Nat) : ¬ (badWords code).c0 < 2 ^ 22 := by
  simp [badWords]

theorem decode_encode_small (w : Counter5)
    (hsum : counterSum w < 1565526) :
    decode ⟨encode w, encode_lt w⟩ = w := by
  have hc0 : w.c0 < 2 ^ 22 := by
    have hle : w.c0 ≤ counterSum w := by
      simp only [counterSum]
      omega
    exact lt_trans (lt_of_le_of_lt hle hsum) (by decide)
  have henc : encode w = counterRank w := if_pos ⟨hc0, hsum⟩
  unfold decode
  split_ifs with h
  · have hspec := Classical.choose_spec h
    have heq : counterRank (Classical.choose h) = counterRank w := by
      rw [hspec.2, ← henc]
    apply Counter5.ext
    · exact (packRank_injective heq).1
    · exact (packRank_injective heq).2.1
    · exact (packRank_injective heq).2.2.1
    · exact (packRank_injective heq).2.2.2.1
    · exact (packRank_injective heq).2.2.2.2
  · exfalso
    apply h
    exact ⟨w, hsum, henc.symm⟩

#print axioms encode_lt
#print axioms decode_encode
#print axioms decode_encode_small

end Radix12
end
