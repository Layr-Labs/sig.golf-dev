section

set_option maxRecDepth 10000
set_option maxHeartbeats 300000

namespace Radix12

def chooseMax (k bound code : Nat) : Nat :=
  Nat.findGreatest (fun n => n.choose k ≤ code) bound

theorem chooseMax_eq_of_interval (k bound n code : Nat)
    (hbound : n ≤ bound)
    (hlo : n.choose k ≤ code)
    (hhi : code < (n + 1).choose k) :
    chooseMax k bound code = n := by
  unfold chooseMax
  apply Nat.findGreatest_eq_iff.mpr
  refine ⟨hbound, ?_, ?_⟩
  · intro _
    exact hlo
  · intro m hnm _ hm
    have hmono := Nat.choose_le_choose k (show n + 1 ≤ m by omega)
    omega

def greedyBars (code : Nat) : Nat × Nat × Nat × Nat × Nat := Id.run do
  let b4 := chooseMax 5 (1565526 + 3) code
  let r4 := code - b4.choose 5
  let b3 := chooseMax 4 b4 r4
  let r3 := r4 - b3.choose 4
  let b2 := chooseMax 3 b3 r3
  let r2 := r3 - b2.choose 3
  let b1 := chooseMax 2 b2 r2
  let r1 := r2 - b1.choose 2
  let b0 := chooseMax 1 b1 r1
  return (b0,b1,b2,b3,b4)

theorem greedyBars_rank5
    {b0 b1 b2 b3 b4 : Nat}
    (h01 : b0 < b1) (h12 : b1 < b2) (h23 : b2 < b3) (h34 : b3 < b4)
    (hbound : b4 ≤ 1565526 + 3) :
    greedyBars (rank5 b0 b1 b2 b3 b4) = (b0,b1,b2,b3,b4) := by
  have h4i := rank5_interval h01 h12 h23 h34
  have hb4 : chooseMax 5 (1565526 + 3) (rank5 b0 b1 b2 b3 b4) = b4 :=
    chooseMax_eq_of_interval 5 _ b4 _ hbound h4i.1 h4i.2
  have hr4 : rank5 b0 b1 b2 b3 b4 - b4.choose 5 = rank4 b0 b1 b2 b3 := by
    simp [rank5]
  have h3i := rank4_self_interval h01 h12 h23
  have hb3 : chooseMax 4 b4 (rank4 b0 b1 b2 b3) = b3 :=
    chooseMax_eq_of_interval 4 _ b3 _ (by omega) h3i.1 h3i.2
  have hr3 : rank4 b0 b1 b2 b3 - b3.choose 4 = rank3 b0 b1 b2 := by
    simp [rank4]
  have h2i := rank3_self_interval h01 h12
  have hb2 : chooseMax 3 b3 (rank3 b0 b1 b2) = b2 :=
    chooseMax_eq_of_interval 3 _ b2 _ (by omega) h2i.1 h2i.2
  have hr2 : rank3 b0 b1 b2 - b2.choose 3 = rank2 b0 b1 := by
    simp [rank3]
  have h1i := rank2_self_interval h01
  have hb1 : chooseMax 2 b2 (rank2 b0 b1) = b1 :=
    chooseMax_eq_of_interval 2 _ b1 _ (by omega) h1i.1 h1i.2
  have hr1 : rank2 b0 b1 - b1.choose 2 = rank1 b0 := by
    simp [rank2]
  have h0i : b0.choose 1 ≤ rank1 b0 ∧ rank1 b0 < (b0 + 1).choose 1 := by
    simp [rank1, Nat.choose_one_right]
  have hb0 : chooseMax 1 b1 (rank1 b0) = b0 :=
    chooseMax_eq_of_interval 1 _ b0 _ (by omega) h0i.1 h0i.2
  simp only [greedyBars, hb4, hr4, hb3, hr3, hb2, hr2, hb1, hr1, hb0]
  rfl

def counterBars (w : Counter5) : Nat × Nat × Nat × Nat × Nat :=
  (bar0 w.c0, bar1 w.c0 w.c1, bar2 w.c0 w.c1 w.c2,
    bar3 w.c0 w.c1 w.c2 w.c3, bar4 w.c0 w.c1 w.c2 w.c3 w.c4)

def fromBars : Nat × Nat × Nat × Nat × Nat → Counter5
  | (b0,b1,b2,b3,b4) =>
      ⟨b0, b1 - b0 - 1, b2 - b1 - 1, b3 - b2 - 1, b4 - b3 - 1⟩

theorem fromBars_counterBars (w : Counter5) : fromBars (counterBars w) = w := by
  cases w with
  | mk c0 c1 c2 c3 c4 =>
    apply Counter5.ext <;>
      simp only [fromBars, counterBars, bar0, bar1, bar2, bar3, bar4] <;>
      omega

def greedyDecoded (code : Nat) : Counter5 := fromBars (greedyBars code)

theorem greedyDecoded_rank (w : Counter5)
    (hsum : counterSum w < 1565526) :
    greedyDecoded (counterRank w) = w := by
  have h01 : bar0 w.c0 < bar1 w.c0 w.c1 := by simp [bar0, bar1]
  have h12 : bar1 w.c0 w.c1 < bar2 w.c0 w.c1 w.c2 := by simp [bar1, bar2]
  have h23 : bar2 w.c0 w.c1 w.c2 < bar3 w.c0 w.c1 w.c2 w.c3 := by simp [bar2, bar3]
  have h34 : bar3 w.c0 w.c1 w.c2 w.c3 < bar4 w.c0 w.c1 w.c2 w.c3 w.c4 :=
    by simp [bar3, bar4]
  have hb : bar4 w.c0 w.c1 w.c2 w.c3 w.c4 ≤ 1565526 + 3 := by
    simp only [counterSum, bar4] at hsum ⊢
    omega
  change fromBars (greedyBars (packRank w.c0 w.c1 w.c2 w.c3 w.c4)) = w
  rw [show packRank w.c0 w.c1 w.c2 w.c3 w.c4 =
      rank5 (bar0 w.c0) (bar1 w.c0 w.c1) (bar2 w.c0 w.c1 w.c2)
        (bar3 w.c0 w.c1 w.c2 w.c3) (bar4 w.c0 w.c1 w.c2 w.c3 w.c4) from rfl]
  rw [greedyBars_rank5 h01 h12 h23 h34 hb]
  exact fromBars_counterBars w

def decodeGreedy (code : Fin (2 ^ 96)) : Counter5 :=
  let w := greedyDecoded code.val
  if counterSum w < 1565526 ∧ counterRank w = code.val then w
  else badWords code.val

theorem decodeGreedy_encode_small (w : Counter5)
    (hsum : counterSum w < 1565526) :
    decodeGreedy ⟨encode w, encode_lt w⟩ = w := by
  have hc0 : w.c0 < 2 ^ 22 := by
    have hle : w.c0 ≤ counterSum w := by
      simp only [counterSum]
      omega
    exact lt_trans (lt_of_le_of_lt hle hsum) (by decide)
  have henc : encode w = counterRank w := if_pos ⟨hc0, hsum⟩
  unfold decodeGreedy
  have hdec : greedyDecoded (encode w) = w := by rw [henc]; exact greedyDecoded_rank w hsum
  rw [hdec]
  simp [hsum, henc]

theorem encode_badWords (code : Fin (2 ^ 96)) :
    encode (badWords code.val) = code.val := by
  have hbranch : ¬ ((badWords code.val).c0 < 2 ^ 22 ∧
      counterSum (badWords code.val) < 1565526) := by
    simp [badWords]
  simp only [encode, if_neg hbranch, badPayload, badWords]
  have hcode := code.isLt
  norm_num at hcode ⊢
  omega

theorem decodeGreedy_encode (code : Fin (2 ^ 96)) :
    encode (decodeGreedy code) = code.val := by
  change encode (if counterSum (greedyDecoded code.val) < 1565526 ∧
      counterRank (greedyDecoded code.val) = code.val then
        greedyDecoded code.val else badWords code.val) = code.val
  split_ifs with h
  · obtain ⟨hsum, hrank⟩ := h
    have hc0 : (greedyDecoded code.val).c0 < 2 ^ 22 := by
      have hle : (greedyDecoded code.val).c0 ≤
          counterSum (greedyDecoded code.val) := by
        simp only [counterSum]
        omega
      exact lt_trans (lt_of_le_of_lt hle hsum) (by decide)
    exact (if_pos ⟨hc0, hsum⟩).trans hrank
  · exact encode_badWords code

#print axioms chooseMax_eq_of_interval
#print axioms greedyBars_rank5
#print axioms decodeGreedy_encode_small
#print axioms decodeGreedy_encode

end Radix12
