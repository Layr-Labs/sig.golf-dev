      rw [← ENNReal.inv_pow, mul_comm, ← ENNReal.div_eq_inv_mul,
        show (515 : Nat) = 256 + 259 by norm_num,
        two_pow_div_two_pow]
    _ ≤ x ^ 256 := inv_two_pow_anti (by norm_num)

#print axioms radix12_complete_numeric
