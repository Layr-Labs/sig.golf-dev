section

set_option maxRecDepth 10000
set_option maxHeartbeats 300000

namespace Radix12

def bar0 (c0 : Nat) : Nat := c0
def bar1 (c0 c1 : Nat) : Nat := c0 + c1 + 1
def bar2 (c0 c1 c2 : Nat) : Nat := c0 + c1 + c2 + 2
def bar3 (c0 c1 c2 c3 : Nat) : Nat := c0 + c1 + c2 + c3 + 3
def bar4 (c0 c1 c2 c3 c4 : Nat) : Nat := c0 + c1 + c2 + c3 + c4 + 4

def rank1 (b0 : Nat) : Nat := b0.choose 1
def rank2 (b0 b1 : Nat) : Nat := rank1 b0 + b1.choose 2
def rank3 (b0 b1 b2 : Nat) : Nat := rank2 b0 b1 + b2.choose 3
def rank4 (b0 b1 b2 b3 : Nat) : Nat := rank3 b0 b1 b2 + b3.choose 4
def rank5 (b0 b1 b2 b3 b4 : Nat) : Nat := rank4 b0 b1 b2 b3 + b4.choose 5

theorem rank1_interval {b0 b1 : Nat} (h01 : b0 < b1) :
    b0.choose 1 ≤ rank1 b0 ∧ rank1 b0 < b1.choose 1 := by
  simp [rank1, Nat.choose_one_right, h01]

theorem rank2_interval {b0 b1 b2 : Nat}
    (h01 : b0 < b1) (h12 : b1 < b2) :
    b1.choose 2 ≤ rank2 b0 b1 ∧ rank2 b0 b1 < b2.choose 2 := by
  have h1 := (rank1_interval h01).2
  have hpas : (b1 + 1).choose 2 = b1.choose 1 + b1.choose 2 := by
    simpa using Nat.choose_succ_succ' b1 1
  have hmono := Nat.choose_le_choose 2 (show b1 + 1 ≤ b2 by omega)
  constructor
  · simp [rank2]
  · dsimp [rank2]
    omega

theorem rank3_interval {b0 b1 b2 b3 : Nat}
    (h01 : b0 < b1) (h12 : b1 < b2) (h23 : b2 < b3) :
    b2.choose 3 ≤ rank3 b0 b1 b2 ∧ rank3 b0 b1 b2 < b3.choose 3 := by
  have h2 := (rank2_interval h01 h12).2
  have hpas : (b2 + 1).choose 3 = b2.choose 2 + b2.choose 3 := by
    simpa using Nat.choose_succ_succ' b2 2
  have hmono := Nat.choose_le_choose 3 (show b2 + 1 ≤ b3 by omega)
  constructor
  · simp [rank3]
  · dsimp [rank3]
    omega

theorem rank4_interval {b0 b1 b2 b3 b4 : Nat}
    (h01 : b0 < b1) (h12 : b1 < b2) (h23 : b2 < b3) (h34 : b3 < b4) :
    b3.choose 4 ≤ rank4 b0 b1 b2 b3 ∧ rank4 b0 b1 b2 b3 < b4.choose 4 := by
  have h3 := (rank3_interval h01 h12 h23).2
  have hpas : (b3 + 1).choose 4 = b3.choose 3 + b3.choose 4 := by
    simpa using Nat.choose_succ_succ' b3 3
  have hmono := Nat.choose_le_choose 4 (show b3 + 1 ≤ b4 by omega)
  constructor
  · simp [rank4]
  · dsimp [rank4]
    omega

theorem rank5_interval {b0 b1 b2 b3 b4 : Nat}
    (h01 : b0 < b1) (h12 : b1 < b2) (h23 : b2 < b3) (h34 : b3 < b4) :
    b4.choose 5 ≤ rank5 b0 b1 b2 b3 b4 ∧
      rank5 b0 b1 b2 b3 b4 < (b4 + 1).choose 5 := by
  have h4 := (rank4_interval h01 h12 h23 h34).2
  have hpas : (b4 + 1).choose 5 = b4.choose 4 + b4.choose 5 := by
    simpa using Nat.choose_succ_succ' b4 4
  constructor
  · simp [rank5]
  · dsimp [rank5]
    omega

theorem rank2_self_interval {b0 b1 : Nat} (h01 : b0 < b1) :
    b1.choose 2 ≤ rank2 b0 b1 ∧ rank2 b0 b1 < (b1 + 1).choose 2 :=
  rank2_interval h01 (Nat.lt_succ_self b1)

theorem rank3_self_interval {b0 b1 b2 : Nat}
    (h01 : b0 < b1) (h12 : b1 < b2) :
    b2.choose 3 ≤ rank3 b0 b1 b2 ∧ rank3 b0 b1 b2 < (b2 + 1).choose 3 :=
  rank3_interval h01 h12 (Nat.lt_succ_self b2)

theorem rank4_self_interval {b0 b1 b2 b3 : Nat}
    (h01 : b0 < b1) (h12 : b1 < b2) (h23 : b2 < b3) :
    b3.choose 4 ≤ rank4 b0 b1 b2 b3 ∧
      rank4 b0 b1 b2 b3 < (b3 + 1).choose 4 :=
  rank4_interval h01 h12 h23 (Nat.lt_succ_self b3)

theorem choose_interval_index_eq (k n m x y : Nat)
    (hnlo : n.choose k ≤ x) (hnhi : x < (n + 1).choose k)
    (hmlo : m.choose k ≤ y) (hmhi : y < (m + 1).choose k)
    (hxy : x = y) : n = m := by
  by_contra hne
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · have hmono := Nat.choose_le_choose k (show n + 1 ≤ m by omega)
    omega
  · have hmono := Nat.choose_le_choose k (show m + 1 ≤ n by omega)
    omega

theorem rank5_injective_onIncreasing
    {a0 a1 a2 a3 a4 b0 b1 b2 b3 b4 : Nat}
    (ha01 : a0 < a1) (ha12 : a1 < a2) (ha23 : a2 < a3) (ha34 : a3 < a4)
    (hb01 : b0 < b1) (hb12 : b1 < b2) (hb23 : b2 < b3) (hb34 : b3 < b4)
    (heq : rank5 a0 a1 a2 a3 a4 = rank5 b0 b1 b2 b3 b4) :
    a0 = b0 ∧ a1 = b1 ∧ a2 = b2 ∧ a3 = b3 ∧ a4 = b4 := by
  have hia := rank5_interval ha01 ha12 ha23 ha34
  have hib := rank5_interval hb01 hb12 hb23 hb34
  have h4 : a4 = b4 :=
    choose_interval_index_eq 5 a4 b4 _ _ hia.1 hia.2 hib.1 hib.2 heq
  have heq4 : rank4 a0 a1 a2 a3 = rank4 b0 b1 b2 b3 := by
    rw [h4] at heq
    dsimp [rank5] at heq
    omega
  have hia3 := rank4_self_interval ha01 ha12 ha23
  have hib3 := rank4_self_interval hb01 hb12 hb23
  have h3 : a3 = b3 :=
    choose_interval_index_eq 4 a3 b3 _ _ hia3.1 hia3.2 hib3.1 hib3.2 heq4
  have heq3 : rank3 a0 a1 a2 = rank3 b0 b1 b2 := by
    rw [h3] at heq4
    dsimp [rank4] at heq4
    omega
  have hia2 := rank3_self_interval ha01 ha12
  have hib2 := rank3_self_interval hb01 hb12
  have h2 : a2 = b2 :=
    choose_interval_index_eq 3 a2 b2 _ _ hia2.1 hia2.2 hib2.1 hib2.2 heq3
  have heq2 : rank2 a0 a1 = rank2 b0 b1 := by
    rw [h2] at heq3
    dsimp [rank3] at heq3
    omega
  have hia1 := rank2_self_interval ha01
  have hib1 := rank2_self_interval hb01
  have h1 : a1 = b1 :=
    choose_interval_index_eq 2 a1 b1 _ _ hia1.1 hia1.2 hib1.1 hib1.2 heq2
  have heq1 : rank1 a0 = rank1 b0 := by
    rw [h1] at heq2
    dsimp [rank2] at heq2
    omega
  have h0 : a0 = b0 := by simpa [rank1, Nat.choose_one_right] using heq1
  exact ⟨h0, h1, h2, h3, h4⟩

def packRank (c0 c1 c2 c3 c4 : Nat) : Nat :=
  rank5 (bar0 c0) (bar1 c0 c1) (bar2 c0 c1 c2)
    (bar3 c0 c1 c2 c3) (bar4 c0 c1 c2 c3 c4)

theorem packRank_lt_96bits {c0 c1 c2 c3 c4 : Nat}
    (hsum : c0 + c1 + c2 + c3 + c4 < 1565526) :
    packRank c0 c1 c2 c3 c4 < 2 ^ 96 := by
  have h01 : bar0 c0 < bar1 c0 c1 := by simp [bar0, bar1]
  have h12 : bar1 c0 c1 < bar2 c0 c1 c2 := by simp [bar1, bar2]
  have h23 : bar2 c0 c1 c2 < bar3 c0 c1 c2 c3 := by simp [bar2, bar3]
  have h34 : bar3 c0 c1 c2 c3 < bar4 c0 c1 c2 c3 c4 := by simp [bar3, bar4]
  have hrank := (rank5_interval h01 h12 h23 h34).2
  have hb : bar4 c0 c1 c2 c3 c4 + 1 ≤ 1565526 + 4 := by
    simp only [bar4]
    omega
  exact lt_trans hrank ((Nat.choose_le_choose 5 hb).trans_lt radix12_96bit_capacity)

theorem packRank_injective
    {c0 c1 c2 c3 c4 d0 d1 d2 d3 d4 : Nat}
    (h : packRank c0 c1 c2 c3 c4 = packRank d0 d1 d2 d3 d4) :
    c0 = d0 ∧ c1 = d1 ∧ c2 = d2 ∧ c3 = d3 ∧ c4 = d4 := by
  have hc01 : bar0 c0 < bar1 c0 c1 := by simp [bar0, bar1]
  have hc12 : bar1 c0 c1 < bar2 c0 c1 c2 := by simp [bar1, bar2]
  have hc23 : bar2 c0 c1 c2 < bar3 c0 c1 c2 c3 := by simp [bar2, bar3]
  have hc34 : bar3 c0 c1 c2 c3 < bar4 c0 c1 c2 c3 c4 := by simp [bar3, bar4]
  have hd01 : bar0 d0 < bar1 d0 d1 := by simp [bar0, bar1]
  have hd12 : bar1 d0 d1 < bar2 d0 d1 d2 := by simp [bar1, bar2]
  have hd23 : bar2 d0 d1 d2 < bar3 d0 d1 d2 d3 := by simp [bar2, bar3]
  have hd34 : bar3 d0 d1 d2 d3 < bar4 d0 d1 d2 d3 d4 := by simp [bar3, bar4]
  have hbars := rank5_injective_onIncreasing hc01 hc12 hc23 hc34
    hd01 hd12 hd23 hd34 h
  dsimp [bar0, bar1, bar2, bar3, bar4] at hbars
  omega

#print axioms rank5_interval
#print axioms rank5_injective_onIncreasing
#print axioms packRank_lt_96bits
#print axioms packRank_injective

end Radix12
end
-- END Radix12Combinadic

