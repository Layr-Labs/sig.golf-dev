theorem fors_sim (S : List Byte) (hS : S.length = 32) (N : Nat) (tF : MachineState)
    (ctx : ForsCtx S (idxOf N) N tF) (hpc : tF.pc = pcOf 156)
    (h8 : tF.getReg .x8 = BitVec.ofNat 64 0) (h18 : tF.getReg .x18 = BitVec.ofNat 64 0x2650) :
