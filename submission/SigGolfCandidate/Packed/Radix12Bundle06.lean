  induction fuel with
  | zero =>
      intro s k rank lo hi hpc hs hk hk5 hlohi hhi hlo hrhi hfuel hfuel9 hrank
      omega
  | succ f ih =>
      intro s k rank lo hi hpc hs hk hk5 hlohi hhi hlo hrhi hfuel hfuel9 hrank
      let mid := (lo + hi) / 2
      let test := rank < Nat.choose mid k
      let lo' := if test then lo else mid
      let hi' := if test then mid else hi
