      BitVec.lt_def, BitVec.toNat_ofNat,
      Nat.mod_eq_of_lt hcode64,
      Nat.mod_eq_of_lt (show 68674865952 < 2 ^ 64 by decide)]
    exact hcap
  simp [htest]

