section
namespace Radix12SplitFrameX2
open RiscvZkvm.Rv64 SigGolfCandidate.Legacy SigGolfCandidate.Legacy.Riscv
  SigGolfCandidate.Rv Radix12SplitExpandImageSD
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000

def SafeX2 : SigGolfCandidate.Rv.Micro → Prop
  | .alu rd _ _ _ | .load _ rd _ _ | .jal rd _ | .jalr rd _ _ => rd ≠ .x2
  | .store .. | .branch .. => True
instance (m : SigGolfCandidate.Rv.Micro) : Decidable (SafeX2 m) := by
  cases m <;> simp [SafeX2] <;> infer_instance

def safeMicroB : SigGolfCandidate.Rv.Micro → Bool
  | .alu rd _ _ _ | .load _ rd _ _ | .jal rd _ | .jalr rd _ _ => rd != .x2
  | .store .. | .branch .. => true

def safeWordB (w : BitVec 32) : Bool :=
  match decodeInstruction w with
  | some i =>
      match SigGolfCandidate.Rv.classify i with
      | some m => safeMicroB m
      | none => w == 0x00000073
  | none => true

theorem code_safe :
    expandCode.all safeWordB = true := by
  decide +kernel

theorem micro_frame (m : SigGolfCandidate.Rv.Micro) (s t : MachineState)
    (hm : safeMicroB m = true)
    (hs : m.exec s = some t) :
    t.getReg .x2 = s.getReg .x2 := by
  cases m with
  | alu rd op a b =>
      simp only [safeMicroB, bne_iff_ne] at hm
      simp only [SigGolfCandidate.Rv.Micro.exec, Option.some.injEq] at hs
      subst t
      simp only [MachineState.getReg_setPC]
      exact MachineState.getReg_setReg_ne s rd .x2 _ hm

  | load k rd rs off =>
      simp only [safeMicroB, bne_iff_ne] at hm
      simp only [SigGolfCandidate.Rv.Micro.exec] at hs
      split_ifs at hs
      cases hs
      simp only [MachineState.getReg_setPC]
      exact MachineState.getReg_setReg_ne s rd .x2 _ hm
  | store k rs1 rs2 off =>
      simp only [SigGolfCandidate.Rv.Micro.exec] at hs
      split_ifs at hs
      cases hs
      cases k <;> rfl
  | branch op rs1 rs2 off =>
      simp only [SigGolfCandidate.Rv.Micro.exec] at hs
      split_ifs at hs <;> cases hs <;> rfl
  | jal rd off =>
      simp only [safeMicroB, bne_iff_ne] at hm
      simp only [SigGolfCandidate.Rv.Micro.exec, Option.some.injEq] at hs
      subst t
      simp only [MachineState.getReg_setPC]
      exact MachineState.getReg_setReg_ne s rd .x2 _ hm
  | jalr rd rs off =>
      simp only [safeMicroB, bne_iff_ne] at hm
      simp only [SigGolfCandidate.Rv.Micro.exec, Option.some.injEq] at hs
      subst t
      simp only [MachineState.getReg_setPC]
      exact MachineState.getReg_setReg_ne s rd .x2 _ hm

theorem fetch_safe (s : MachineState) (i : Instruction)
    (hf : fetch expandImage s = some i) :
    (∃ m, SigGolfCandidate.Rv.classify i = some m ∧ safeMicroB m = true) ∨
      i = .base .ECALL := by
  unfold fetch at hf
  split_ifs at hf with hpc
  · obtain ⟨w, hw, hdecode⟩ := Option.bind_eq_some_iff.mp hf
    have hmem : w ∈ expandCode := List.mem_of_getElem? hw
    have hsafe := (List.all_eq_true.mp code_safe) w hmem
    simp only [safeWordB, hdecode] at hsafe
    cases hc : SigGolfCandidate.Rv.classify i with
    | none =>
        simp only [hc, beq_iff_eq] at hsafe
        subst w
        have hd : decodeInstruction (0x00000073 : BitVec 32) =
            some (.base .ECALL) := by rfl
        rw [hd] at hdecode
        exact Or.inr (Option.some.inj hdecode).symm
    | some m =>
        simp only [hc] at hsafe
        exact Or.inl ⟨m, rfl, hsafe⟩

theorem steps_x2 {s t : MachineState} {n c : Nat}
    (h : Steps expandImage s n c t) :
    t.getReg .x2 = s.getReg .x2 := by
  induction h with
  | refl => rfl
  | @step s t u i k c hf hs tail ih =>
      rcases fetch_safe s i hf with ⟨m, hclass, hsafe⟩ | hecall
      · rw [SigGolfCandidate.Rv.classify_sound hclass s] at hs
        exact ih.trans (micro_frame m s t hsafe hs)
      · subst i
        simp [ordinaryStep] at hs
#print axioms code_safe
#print axioms micro_frame
#print axioms fetch_safe
#print axioms steps_x2
end Radix12SplitFrameX2
end
