  simp only [Result.toState_pc, mask.res, rv_simp]

theorem mask_mem (s : MachineState) (a : Word) :
    (mask.res.toState s).getMem a = s.getMem a := by
  simp only [Result.toState_getMem, mask.res, memEval]

theorem setup_to_stage (s : MachineState) (code : Nat)
    (hpc : s.pc = BitVec.ofNat 64 (0x1000 + 4 * (15 + 7)))
    (h10 : s.getReg .x10 = BitVec.ofNat 64 code)
    (h7 : s.getReg .x7 = BitVec.ofNat 64 0x20F0)
    (h2 : s.getReg .x2 = BitVec.ofNat 64 0xffc3d0)
    (hcap : code < Nat.choose 385 5)
    (htable : ∀ i < 5 * 385,
      s.getMem (BitVec.ofNat 64 (0xffc3d0 + 8 * i)) =
        BitVec.ofNat 64 (Nat.choose (i % 385) (i / 385 + 1))) :
    ∃ v, Steps expandImage s
        (setup.res.steps + mask.res.steps)
        (setup.res.cycles + mask.res.cycles) v ∧
      Radix12SplitOneStageSD.Input v 5 code 384 := by
  let u := setup.res.toState s
  let v := mask.res.toState u
  have hu : Steps expandImage s setup.res.steps setup.res.cycles u :=
    setup_steps s hpc
  have hupc : u.pc = BitVec.ofNat 64 (0x1000 + 4 * (15 + 23)) :=
    setup_pc s code h10 hcap
  have hv : Steps expandImage u mask.res.steps mask.res.cycles v :=
    mask_steps u hupc
  obtain ⟨hu11,hu12,hu27,hu28,hu10,hu7,hu2,_⟩ := setup_regs s
  obtain ⟨hv11,hv12,hv27,hv28,hv10,hv7,hv2⟩ := mask_regs u
  refine ⟨v, hu.trans hv, ?_⟩
  refine ⟨mask_pc u, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact hv10.trans (hu10.trans h10)
  · exact hv11.trans hu11
  · exact hv12.trans hu12
  · exact hv27.trans hu27
  · exact hv28.trans hu28
  · exact hv7.trans (hu7.trans h7)
  · exact hv2.trans (hu2.trans h2)
  · intro i hi
    rw [mask_mem, setup_mem]
    exact htable i hi

