namespace Radix12MemByteExt
open RiscvZkvm.Rv64 SigGolfCandidate.Mem

theorem mem_eq_of_bytes (s u : MachineState) (A : Nat)
    (hA : A % 8 = 0) (hA' : A + 8 < 2 ^ 64)
    (h : ∀ j < 8, u.getByte (BitVec.ofNat 64 (A + j)) =
      s.getByte (BitVec.ofNat 64 (A + j))) :
    u.getMem (BitVec.ofNat 64 A) = s.getMem (BitVec.ofNat 64 A) := by
  apply SigGolfCandidate.Keygen.word_ext_bytes
  intro j hj
  have heq := h j hj
  simp only [MachineState.getByte] at heq
  have ha : alignToDword (BitVec.ofNat 64 (A + j)) = BitVec.ofNat 64 A := by
    rw [← alignToDword_ofNat_aligned (by omega) hA,
      alignToDword_ofNat_eq (by omega) (by omega)]
    omega
  rw [ha, byteOffset_ofNat (by omega), show (A + j) % 8 = j by omega] at heq
  exact heq

#print axioms mem_eq_of_bytes
end Radix12MemByteExt
