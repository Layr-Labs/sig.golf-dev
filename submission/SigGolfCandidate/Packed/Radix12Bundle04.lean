set_option maxRecDepth 100000
set_option maxHeartbeats 1000000

private theorem write_frame (s : MachineState) (b A : Nat) (l : List (BitVec 8))
    (hb : b + 8 * ((l.length + 7) / 8) < 2 ^ 64)
    (hA : A < 2 ^ 64)
    (hdisj : b + 8 * ((l.length + 7) / 8) ≤ A) :
    (s.writeBytesAsWords (BitVec.ofNat 64 b) l).getMem (BitVec.ofNat 64 A) =
      s.getMem (BitVec.ofNat 64 A) := by
  rw [SigGolfCandidate.Keygen.getMem_writeBytesAsWords l s b A hb hA]
  rw [if_neg (by omega)]

def initState (m : Message) (pk : PublicKey) (σ : Bytes 6396) : MachineState :=
  let blank : MachineState := { regs := fun _ => 0, mem := fun _ => 0, pc := 0x1000 }
  ((((blank.writeBytesAsWords (BitVec.ofNat 64 (dataBase expandImage)) tableData).writeBytesAsWords
      (BitVec.ofNat 64 0x40) (bytes m)).writeBytesAsWords
      (BitVec.ofNat 64 0xA0) (bytes pk)).writeBytesAsWords
      (BitVec.ofNat 64 0x2650) (bytes σ)).setReg .x2
      (BitVec.ofNat 64 (dataBase expandImage))

theorem init_table_load (m : Message) (pk : PublicKey) (σ : Bytes 6396)
    (i : Nat) (hi : i < 5 * 385) :
    (initState m pk σ).getMem
      (BitVec.ofNat 64 (dataBase expandImage + 8 * i)) =
      BitVec.ofNat 64 (Nat.choose (i % 385) (i / 385 + 1)) := by
  unfold initState
  simp only [MachineState.getMem_setReg]
  have hA : dataBase expandImage + 8 * i < 2 ^ 64 := by rw [base_eq]; omega
  rw [write_frame _ 0x2650 _ (bytes σ)
      (by simp [bytes]) hA
      (by simp [bytes, base_eq]; omega),
    write_frame _ 0xA0 _ (bytes pk)
      (by simp [bytes]) hA
      (by simp [bytes, base_eq]; omega),
    write_frame _ 0x40 _ (bytes m)
      (by simp [bytes]) hA
      (by simp [bytes, base_eq]; omega)]
  exact table_load _ i hi

#print axioms init_table_load
end Radix12SplitInitTable
