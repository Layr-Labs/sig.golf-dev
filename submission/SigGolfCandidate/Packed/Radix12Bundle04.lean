    u.getMem (BitVec.ofNat 64 (dataBase expandImage + 8 * i)) =
      BitVec.ofNat 64 (Nat.choose (i % 385) (i / 385 + 1)) := by
  rw [base_eq]
  rw [table_preserved_copy _ u i hi hf]
  simpa only [← base_eq] using Radix12SplitInitTable.init_table_load m pk σ i hi

