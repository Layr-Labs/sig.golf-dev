-- BEGIN Radix12SplitBits from /tmp/Radix12SplitBits.lean
section

namespace Radix12SplitBits

theorem splitRankBits (lo : BitVec 64) (hi : BitVec 32) :
    (lo >>> 60 ||| (hi.zeroExtend 64 <<< 4)) =
      ((hi ++ lo).extractLsb' 60 36).zeroExtend 64 := by
  apply BitVec.eq_of_getLsbD_eq
  intro i hi64
  simp only [BitVec.getLsbD_or, BitVec.getLsbD_ushiftRight,
    BitVec.getLsbD_shiftLeft, BitVec.zeroExtend_eq_setWidth,
    BitVec.getLsbD_setWidth, BitVec.getLsbD_extractLsb',
    BitVec.getLsbD_append]
  by_cases hi4 : i < 4
  · have hs : 60 + i < 64 := by omega
    have hh : i < 36 := by omega
    simp [hi4, hh, hs, show i < 64 by omega]
  · by_cases hi36 : i < 36
    · have hs : 64 ≤ 60 + i := by omega
      have hlo : lo.getLsbD (60 + i) = false :=
        BitVec.getLsbD_of_ge _ _ hs
      have hsub : 60 + i - 64 = i - 4 := by omega
      simp [hi4, hi36, hlo, hs, hsub, show i < 64 by omega,
        show i - 4 < 64 by omega]
    · have hs : 64 ≤ 60 + i := by omega
      have hlo : lo.getLsbD (60 + i) = false :=
        BitVec.getLsbD_of_ge _ _ hs
      have hhi : hi.getLsbD (i - 4) = false :=
        BitVec.getLsbD_of_ge _ _ (by omega)
      simp [hi4, hi36, hlo, hhi, show i < 64 by omega]

theorem splitLowBits (lo : BitVec 64) (hi : BitVec 32) :
    (lo <<< 4 >>> 4).truncate 60 = (hi ++ lo).extractLsb' 0 60 := by
  bv_normalize

theorem splitLowBits64 (lo : BitVec 64) (hi : BitVec 32) :
    lo <<< 4 >>> 4 = ((hi ++ lo).extractLsb' 0 60).zeroExtend 64 := by
  bv_normalize

#print axioms splitRankBits
#print axioms splitLowBits
#print axioms splitLowBits64
end Radix12SplitBits
end
