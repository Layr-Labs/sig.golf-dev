theorem table_preserved_copy (s u : MachineState) (i : Nat) (hi : i < 5 * 385)
    (hf : BytesEq u (applyCopy (0x2650, 0x800, 1596)
      (fun a => s.getByte (BitVec.ofNat 64 a)))) :
    u.getMem (BitVec.ofNat 64 (0xffc3d0 + 8 * i)) =
      s.getMem (BitVec.ofNat 64 (0xffc3d0 + 8 * i)) := by
  let A := 0xffc3d0 + 8 * i
  have hA : A % 8 = 0 := by dsimp [A]; omega
  have hA' : A + 8 < 2 ^ 64 := by dsimp [A]; omega
  apply Radix12MemByteExt.mem_eq_of_bytes s u A hA hA'
  intro j hj'
  have haj : A + j < 2 ^ 64 := by omega
  rw [hf (A + j) haj]
  simp only [applyCopy]
  rw [if_neg (by dsimp [A]; omega)]

theorem table_load_after_body (m : Message) (pk : PublicKey) (σ : Bytes 6396)
    (u : MachineState) (i : Nat) (hi : i < 5 * 385)
    (hf : BytesEq u (applyCopy (0x2650, 0x800, 1596)
