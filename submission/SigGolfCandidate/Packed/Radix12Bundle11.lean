  have e : ∀ k, k < 2 ^ 64 → (BitVec.ofNat 64 x = BitVec.ofNat 64 k ↔ x = k) := by
    intro k hk
    constructor
    · intro h; have := congrArg BitVec.toNat h; simp at this; omega
