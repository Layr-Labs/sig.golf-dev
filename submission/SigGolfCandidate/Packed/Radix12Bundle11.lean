    apply BitVec.eq_of_toNat_eq; simp <;> omega
  have h2 : BitVec.ofNat 64 d + 8 + 8 = BitVec.ofNat 64 (d + 16) := by
    apply BitVec.eq_of_toNat_eq; simp <;> omega
