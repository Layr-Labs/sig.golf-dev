  rw [nonpos_iff_eq_zero, probEvent_eq_zero_iff]
  rintro ⟨b, cache'⟩ hr'
  obtain ⟨f, hf⟩ := QueryCache.exists_agreesWithFn (spec := SphincsSecurity.HashSpec) cache'
  obtain ⟨hle, hverify, _⟩ := replay_of_mem_support _ cache b cache' hr' f hf
