    congrArg Prod.fst hsigned
  have hsign := congrArg Prod.snd hsigned
  rw [hkeys] at hsign
  have htrue := verify_of_keygen_sign f seed message hkeys hsign
  rw [htrue] at hverify
  try dsimp only
  rw [← hverify]
