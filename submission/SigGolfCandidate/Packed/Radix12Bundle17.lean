    (t13 : t.getReg .x13 = BitVec.ofNat 64 e) (t18 : t.getReg .x18 = BitVec.ofNat 64 (0x900 + 856 * lay))
    (t30 : t.getReg .x30 = BitVec.ofNat 64 tau) (tst : Statics S t) :
    ∃ tt, Steps image t 14 14 tt ∧
